+pub fn native_length(v: [f32; 4]) -> f32 {
+    skate_core::physics::board_motion_output::length(
+        skate_core::math::Vector3::new(v[0], v[1], v[2]))
+}
+pub fn native_dot(a: [f32; 4], b: [f32; 4]) -> f32 {
+    use skate_core::math::Vector3;
+    skate_core::physics::board_motion_output::dot(Vector3::new(a[0], a[1], a[2]), Vector3::new(b[0], b[1], b[2]))
+}

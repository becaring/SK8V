+//! Read-only audio publication from completed physical output records.
+//! The audio struct's source offsets are recorded in gv_skater.rs. Expose
+//! only fields whose producer exists; do not synthesize absent audio state.
+use super::Session;
+
+pub(super) struct Settings {
+    slip_scale: f32, slip_offset: f32, wheel_impact_scale: f32,
+    wheel_classes_from_air: bool, wheel_impact_thresholds: [f32; 2], wheel_air_thresholds: [f32; 2],
+    tricks: Vec<(skate_core::animation::output::attributes::AttributeName, TrickAudio)>,
+}
+#[derive(Clone, Copy, Debug)]
+pub struct TrickAudio { pub ids: [i32; 2], pub attribute: bool }
+impl Settings {
+    pub(super) fn load(root: &std::path::Path) -> Result<Self, String> {
+        let data = skate_data::collections::Collections::load(root)?;
+        let class = "Hash_C1831BDB6CB1B1EA";
+        let key = "Hash_BA9837A6CF4C26ED";
+        //827A1FEC..2010 reads the actual scoring-trick collection layout.
+        //Private AttribSys comparison confirms these fields at164/172/176.
+        let mut tricks = Vec::new();
+        for definition in skate_data::scoring::ScoringData::load(&data)?.definitions {
+            let class = "Hash_6918469984A8C596";
+            let key = definition.identifier;
+            tricks.push((definition.encoded_name, TrickAudio {
+                ids: [data.words::<1>(class,key,"Hash_8C3025DB4D1761AF")?[0] as i32,
+                      data.words::<1>(class,key,"Hash_A2C5C22C5BE725F8")?[0] as i32],
+                attribute: data.boolean(class,key,"Hash_7B9298C7883E2FA2")?,
+            }));
+        }
+        Ok(Self {
+            tricks,
+            slip_scale: data.float(class, key, "Hash_56D931D202881C2D")?,
+            slip_offset: data.float(class, key, "Hash_E6C3FFE8AA70F944")?,
+            wheel_impact_scale: data.float("Hash_C26949FCB638A2CA", "default", "Hash_3D399FE04952B425")?,
+            wheel_classes_from_air: data.boolean("Hash_C26949FCB638A2CA", "default", "Hash_642CF9BFEC6BE988")?,
+            wheel_impact_thresholds: [
+                data.float("Hash_C26949FCB638A2CA", "default", "Hash_63B9250BE57DA556")?,
+                data.float("Hash_C26949FCB638A2CA", "default", "Hash_1578F5AD78C9A844")?],
+            wheel_air_thresholds: [
+                data.float("Hash_C26949FCB638A2CA", "default", "Hash_2A70BB8A382574E4")?,
+                data.float("Hash_C26949FCB638A2CA", "default", "Hash_6D3D91A9BA7ADCDC")?],
+        })
+    }
+}

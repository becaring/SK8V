+impl Session {
+    pub fn audio_input(&self) -> AudioInput {
+        let p = &self.skater.player_input.physical;
+        let flags = &self.skater.player_state.state_flags;
+        //82C02ADC..2B20 publishes the unadjusted physical deck transform to
+        //SkateboardReckoning0; effective stance transform starts at64.
+        let basis = self.physics.board.part_transforms()[
+            skate_core::physics::board::BodyId::Deck.index()].basis.columns;
+        let angular = p.skateboard.vector_64.map(f32::from_bits);
+        //82772850..28A4 multiplies by the transpose of that raw basis.
+        let local_angular = core::array::from_fn(|i| {
+            basis[i][2].mul_add(angular[2],
+                basis[i][1].mul_add(angular[1], basis[i][0] * angular[0]))
+        });
+        //82772E18 uses raw SkateboardReckoning0 (not effective stance64).
+        let linear = p.skateboard.vector_80.map(f32::from_bits);
+        let lateral = native_dot(
+            [basis[0][0], basis[0][1], basis[0][2], 0.0], linear).abs();
+        let slip = ((lateral - self.audio_settings.slip_offset).max(0.0)
+            / self.audio_settings.slip_scale).min(1.0);
+        AudioInput {
+            //82BD6A20 publishes current groin/face contact, not a sliding flag.
+            body_specific_contacts: core::array::from_fn(|i| self.skater.collision_feedback.specific[i].current),
+            //82BE50CC confirms assembly stride96 and rates pointer+76;
+            //82BE1F00 reads part23, Rates48 (angular), into Skeleton288.
+            root_angular_speed: {
+                let v = self.skater.skeleton.bodies()[23].rates.angular_velocity;
+                native_length([v.x, v.y, v.z, 0.0])
+            },
+            //82BE1F7C..20DC: pose-derived limb velocities minus Reckoning16.
+            limb_relative_speeds: [17,21,4,8].map(|i| {
+                let v = self.skater.skeleton.record.velocities[i];
+                let com = p.reckoning.vector_16.map(f32::from_bits);
+                native_length(core::array::from_fn(|j| v[j] - com[j]))
+            }),
+            //82DAC498 publishes the UNFILTERED first score name when either
+            //score flag24/25 is set. Do not substitute a HUD label, carrier,
+            //delayed announcement, or the permission-filtered second ID.
+            trick: if self.skater.animation.motion.score_packet.flags & 0x0300_0000 != 0 {
+                self.skater.animation.motion.score_packet.trick_names.first.and_then(|name|
+                    self.audio_settings.tricks.iter().find(|(n,_)|*n==name).map(|(_,v)|*v))
+            } else { None },
+            //82BD68F0..69D0: force clears on no part; material retains its old value.
+            body_contact_valid: core::array::from_fn(|i| self.skater.collision_feedback.regions[i].part.is_some()),
+            body_contact_force: core::array::from_fn(|i| self.skater.collision_feedback.regions[i].force),
+            body_contact_surface: core::array::from_fn(|i| self.skater.collision_feedback.regions[i].material_flags),
+            button_mask: u32::from(self.input.raw_input().buttons),
+            side_slip: if p.collision.wheel_count_0 > 0 { slip } else { 0.0 },
+            wheel_impact_scale: self.audio_settings.wheel_impact_scale,
+            wheel_classes_from_air: self.audio_settings.wheel_classes_from_air,
+            wheel_impact_thresholds: self.audio_settings.wheel_impact_thresholds,
+            wheel_air_thresholds: self.audio_settings.wheel_air_thresholds,
+            //82DB760C..766C: state ID200..299 and Collision0==0.
+            air_no_wheel_contact: (200..300).contains(&p.state.state_16) && p.collision.wheel_count_0 == 0,
+            //82C03284..32C4 copies wheel Rates16 to SkateboardReckoning208..256.
+            wheel_position: core::array::from_fn(|i| {
+                let p = self.physics.board.bodies()[i].rates.position;
+                [p.x, p.y, p.z, 0.0]
+            }),
+            //82C02D54 Motion208..256 copies actual wheel rigid-body velocity.
+            wheel_velocity: core::array::from_fn(|i| {
+                let v = self.physics.board.bodies()[i].rates.linear_velocity;
+                [v.x, v.y, v.z, 0.0]
+            }),
+            //82C02DA8 Collision3376..3424 uses contact normal, zero on miss.
+            wheel_normal: core::array::from_fn(|i| {
+                let p = self.physics.riding.ground.parts[i];
+                if p.in_contact { [p.normal.x, p.normal.y, p.normal.z, 0.0] } else { [0.0; 4] }
+            }),
+            //Shared completed Processed2676 used by PhysicalFeedback.
+            turn: self.skater.animation_input.fields.turn,
+            part_audio_surfaces: self.physics.riding.ground.audio_surfaces,
+            wheel_seam_patterns: core::array::from_fn(|i| self.physics.riding.ground.seam_patterns[i]),
+            wheel_contact: p.collision.wheel_contact_3296_3299,
+            wheel_contact_count: p.collision.wheel_count_0,
+            foot_flags: p.off_board.flags_306_307,
+            //82BE1EC0/1ECC: Skeleton9024/9280 are pose15/19 translations.
+            foot_height: [self.skater.skeleton.record.pose[15][3][1], self.skater.skeleton.record.pose[19][3][1]],
+            //82DB76C8/76DC deliberately publish the SAME Processed2596 tag.
+            foot_surface_tag: self.skater.player_input.processed.left_surface_2596,
+            local_deck_angular_velocity: local_angular,
+            grind_contact: p.grinds.grinding_316,
+            grind_family: p.grinds.words_136_140[0],
+            grind_surface: p.grinds.audio_surface_216,
+            grind_impact: p.grinds.impact_speed_128,
+            grind_flag_323: p.grinds.flag_323,
+            state_category: p.state.category_12,
+            state_id: p.state.state_16,
+            landing_velocity_delta: p.air.jump_velocity_delta_112.map(f32::from_bits),
+            //82DB7494 rotates Processed2468 bit22 into Air440.
+            landing_level_valid: self.skater.player_input.processed.flags_2468 & (1 << 22) != 0,
+            board_ground_speed: p.skateboard.scalar_164,
+            com_velocity: p.reckoning.vector_16.map(f32::from_bits),
+            air_time: p.air.time_in_state_176,
+            air_scalar_184: p.air.scalar_184,
+            jump_height: p.air.jump_height_200,
+            offboard: p.off_board.flag_308,
+            pushing: flags[55 - 52],
+            foot_brake: flags[52 - 52],
+            push_contact: flags[56 - 52],
+            push_right_toe: flags[57 - 52],
+            manual_brake: flags[54 - 52],
+            manual: flags[60 - 52],
+            wiping_out: flags[59 - 52],
+            revert: flags[66 - 52],
+            left_foot_within_deck: p.skeleton.flag_600,
+            right_foot_within_deck: p.skeleton.flag_601,
+            skeleton_over: p.skeleton.over_599,
+        }
+    }
+}

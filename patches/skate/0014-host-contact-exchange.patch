+//! SkateV contact exchange with a foreign host's moving entities (GTA
+//! vehicles and props). Shared contacts, separate physics owners: each nearby
+//! host entity joins the board/skater solve as an attached proxy body carrying
+//! the host's own velocities and mass, like the mashup's remote-player proxies
+//! (network.rs). The host keeps simulating the entity; this solve only uses the
+//! proxy to compute the contact response, and the impulse the board and
+//! skater apply to it is returned to the host. Proxies are rebuilt every tick
+//! and never retain solved state.
+use skate_core::{
+    math::{Basis3, Vector3},
+    physics::{
+        assembly::BodySnapshot,
+        board_step::{ATTACHED_REACTION_BASE, CollisionBody},
+        contact_solver::RetailContactJacobian,
+        rigid_body::{RetailQuaternion, world_inverse_inertia},
+    },
+};
+
+/// One host entity as sampled by the host (Skate space, metres, seconds).
+#[derive(Clone, Copy, Debug)]
+pub struct HostBody {
+    /// Host entity tag (the same tag its dynamic triangles carry).
+    pub tag: u32,
+    /// Centre of mass and orientation (basis columns: local x, y, z).
+    pub position: [f32; 3],
+    pub orientation: [f32; 4],
+    pub linear_velocity: [f32; 3],
+    /// World angular velocity, radians per second.
+    pub angular_velocity: [f32; 3],
+    /// 0 for an entity whose mass the host could not supply: it then moves
+    /// kinematically for this solve (infinite mass).
+    pub inverse_mass: f32,
+    /// Principal inverse inertia in the body frame (0: kinematic).
+    pub inverse_inertia: [f32; 3],
+}
+
+/// Impulse (newton-seconds, Skate space) the board/skater applied to a host
+/// entity at a world point during one solve.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct HostImpulse {
+    pub tag: u32,
+    pub point: [f32; 3],
+    pub impulse: [f32; 3],
+}
+
+#[derive(Default)]
+pub(crate) struct Proxies {
+    pub inputs: Vec<HostBody>,
+    pub bodies: Vec<BodySnapshot>,
+    /// Attached index of `bodies[0]` in the current solve.
+    pub base: usize,
+    /// Impulses accumulated since the host last drained them.
+    pub impulses: Vec<HostImpulse>,
+}
+
+impl Proxies {
+    /// Rebuild the proxy bodies from the latest host samples, using a board
+    /// body only as the field template (every physical field is replaced).
+    pub fn build(&mut self, template: &BodySnapshot, base: usize) {
+        self.base = base;
+        self.bodies.clear();
+        for h in &self.inputs {
+            let mut b = *template;
+            let q = h.orientation;
+            let quat = bevy::math::Quat::from_xyzw(q[0], q[1], q[2], q[3]).normalize();
+            b.rates.orientation = RetailQuaternion { x: quat.x, y: quat.y, z: quat.z, w: quat.w };
+            b.rates.basis = Basis3 { columns: bevy::math::Mat3::from_quat(quat).to_cols_array_2d() };
+            let finite = |v: f32| if v.is_finite() && v > 0.0 { v } else { 0.0 };
+            b.inertia.inverse_mass = finite(h.inverse_mass);
+            b.inertia.inverse_tensor = if b.inertia.inverse_mass > 0.0 {
+                Vector3::new(finite(h.inverse_inertia[0]), finite(h.inverse_inertia[1]), finite(h.inverse_inertia[2]))
+            } else {
+                Vector3::ZERO
+            };
+            // The host owns this body's motion limits and damping.
+            b.inertia.maximum_linear_velocity = f32::MAX;
+            b.inertia.maximum_angular_velocity = f32::MAX;
+            b.inertia.linear_drag = 0.0;
+            b.inertia.angular_drag = 0.0;
+            b.rates.world_inverse_inertia = world_inverse_inertia(b.rates.basis, b.inertia.inverse_tensor);
+            b.rates.position = Vector3::new(h.position[0], h.position[1], h.position[2]);
+            b.rates.linear_velocity = Vector3::new(h.linear_velocity[0], h.linear_velocity[1], h.linear_velocity[2]);
+            b.rates.angular_velocity = Vector3::new(h.angular_velocity[0], h.angular_velocity[1], h.angular_velocity[2]);
+            b.rates.force_acceleration = Vector3::ZERO;
+            b.rates.torque_acceleration = Vector3::ZERO;
+            b.state_flags = 4;
+            self.bodies.push(b);
+        }
+    }
+
+    /// Host entity tag -> the proxy solver body standing for it, with the
+    /// entity's linear velocity.
+    pub fn body_map(&self) -> std::collections::HashMap<u32, (CollisionBody, Vector3)> {
+        self.inputs
+            .iter()
+            .enumerate()
+            .map(|(i, h)| {
+                let v = h.linear_velocity;
+                (h.tag, (CollisionBody::Attached(self.base + i), Vector3::new(v[0], v[1], v[2])))
+            })
+            .collect()
+    }
+
+    /// Accumulate, from the solved rows, the impulse every contact applied to
+    /// each proxy. A row's accumulated values are force * dt^2 (board reports
+    /// publish force as value * frequency^2), so the impulse is value *
+    /// frequency, along the row's normal and two tangents. Body A's normal
+    /// force is +normal, so a proxy on side B receives the negative.
+    ///
+    /// Newton's third law bounds what all proxies together receive in one
+    /// solve: the momentum the physical rider and board (`mass`) gained in it
+    /// (`velocity_change` of their centre of mass) plus their weight for the
+    /// tick (support). Larger row sums come from overlap recovery against
+    /// animation-driven parts (a car driving into the rider between samples,
+    /// a pinned ragdoll), which carries no physical momentum and must not
+    /// launch the host entity.
+    pub fn collect(&mut self, contacts: &[RetailContactJacobian], frequency: f32, mass: f32, velocity_change: Vector3) {
+        let start = self.impulses.len();
+        let first = ATTACHED_REACTION_BASE + self.base;
+        let range = first..first + self.bodies.len();
+        for c in contacts {
+            let (proxy, sign, offset) = if range.contains(&c.reaction_index_b) {
+                (c.reaction_index_b - first, -1.0, 4)
+            } else if range.contains(&c.reaction_index_a) {
+                (c.reaction_index_a - first, 1.0, 0)
+            } else {
+                continue;
+            };
+            let w = c.words();
+            let lambda = c.accumulated_impulse();
+            let v = |o: usize| Vector3::new(f32::from_bits(w[o]), f32::from_bits(w[o + 1]), f32::from_bits(w[o + 2]));
+            let (n, t0, t1) = (v(28), v(40), v(52));
+            let scale = sign * frequency;
+            let impulse = [0, 1, 2].map(|k| {
+                let pick = |u: Vector3| [u.x, u.y, u.z][k];
+                (pick(n) * lambda[0] + pick(t0) * lambda[1] + pick(t1) * lambda[2]) * scale
+            });
+            if impulse.iter().all(|x| *x == 0.0) || impulse.iter().any(|x| !x.is_finite()) {
+                continue;
+            }
+            if std::env::var("SKATEV_EXCHANGE_TRACE").is_ok_and(|x| x == "1") {
+                eprintln!("EXCHANGE row a={} b={} ids=({},{}) proxy={proxy} sign={sign} lambda={lambda:?} n={:?} t0={:?} t1={:?} impulse={impulse:?}",
+                    c.reaction_index_a, c.reaction_index_b, w[31], w[43], n, t0, t1);
+            }
+            let centre = self.bodies[proxy].rates.position;
+            let r = v(offset);
+            self.impulses.push(HostImpulse {
+                tag: self.inputs[proxy].tag,
+                point: [centre.x + r.x, centre.y + r.y, centre.z + r.z],
+                impulse,
+            });
+        }
+        // Third-law bound over this solve's impulses on all proxies.
+        let rows = start..self.impulses.len();
+        if rows.is_empty() {
+            return;
+        }
+        let total = self.impulses[rows.clone()].iter().fold([0.0f32; 3], |s, i| {
+            [s[0] + i.impulse[0], s[1] + i.impulse[1], s[2] + i.impulse[2]]
+        });
+        let magnitude = (total[0] * total[0] + total[1] * total[1] + total[2] * total[2]).sqrt();
+        let dv = (velocity_change.x.powi(2) + velocity_change.y.powi(2) + velocity_change.z.powi(2)).sqrt();
+        let bound = mass * (dv + 9.81 / frequency);
+        if magnitude > bound && magnitude > 0.0 {
+            let k = bound / magnitude;
+            for i in &mut self.impulses[rows] {
+                i.impulse = [i.impulse[0] * k, i.impulse[1] * k, i.impulse[2] * k];
+            }
+        }
+    }
+}

+/// Total mass and linear momentum of the physical board and rider.
+fn rider_momentum(physics: &GamePhysics, skater: &SkaterRuntime) -> (f32, [f32; 3]) {
+    let (mut mass, mut momentum) = (0.0f32, [0.0f32; 3]);
+    for body in physics.board.bodies().iter().chain(skater.skeleton.bodies()) {
+        let inverse = body.inertia.inverse_mass;
+        if inverse > 0.0 && inverse.is_finite() {
+            let m = 1.0 / inverse;
+            let v = body.rates.linear_velocity;
+            mass += m;
+            momentum = [momentum[0] + m * v.x, momentum[1] + m * v.y, momentum[2] + m * v.z];
+        }
+    }
+    (mass, momentum)
+}

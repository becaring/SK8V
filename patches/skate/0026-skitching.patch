+    assert_eq!(math::at_distance(&r, -5.0), [-1.0, 1.0, 3.0, 0.0]);
+    assert_eq!(math::at_distance(&r, 5.0), [1.0, 1.0, 3.0, 0.0]);
+    let p = math::at_distance(&r, 0.5);
+    assert!((p[0] - 0.5).abs() < 1e-5 && p[2] == 3.0);
+    let mut reversed = r.clone();

+            scale(scale(self.pull_direction_784, -(s.pull_damping_71a8 * self.absorb_956)), inverse_c),
+        );
+        clamp_length(scale(scale(force, p.mass), reciprocal(STEP)), 500.0)
+    }
+
+    ///82D4B8C0 with 82D4BAC0/82D4BCF8: pull direction, body angle and the
+    ///requested deck angular displacement (applied only while moving).
+    pub fn steer(&mut self, s: &Settings, effective_z: V) -> V {
+        let n = self.normal_800;
+        self.target_736 = line_point(&self.grab_frame_528, self.target_864);
+        let toward = sub(self.target_736, self.board_592);
+        let along = sub(line_point(&self.grab_frame_528, self.along_836), self.board_592);
+        self.pull_direction_784 = normalize(reject(toward, n));
+        let along = normalize(reject(along, n));
+        self.pull_angle_952 = wrap(signed_angle(along, self.pull_direction_784, n));
+        let angle = wrap(signed_angle(effective_z, self.pull_direction_784, n));
+        let grab = wrap(signed_angle(effective_z, self.grab_direction_624, n));
+        let difference = wrap(angle - grab);
+        let angular = self.turn(s, angle, difference);
+        self.angle_940 = if self.flags_1345 & 0x40 != 0 { difference } else { -grab };
+        angular
+    }
+    ///82D4BCF8 rate-limited turn about the up-facing normal.
+    fn turn(&self, s: &Settings, angle: f32, difference: f32) -> V {
+        let rate = (s.turn_rate_0b19 * f32::from_bits(0x3c8e_fa35)) * STEP;
+        let step = clamp(angle, -rate, rate);
+        let n = self.normal_800;
+        let up = if 0.0 > n[1] { scale(n, -1.0) } else { n };
+        let v = scale(up, crate::trigonometry::sin(step));
+        let time = s.turn_time_3f79.evaluate(self.time_992);
+        let speed = s.heading_adjust_vs_speed.evaluate(self.speed_832);
+        let degrees = difference * 180.0 * f32::from_bits(0x3ea2_f983);
+        let settle = if self.flag_1004 == 1 && degrees.abs() < 1.0 {
+            s.turn_settle_1ff7.evaluate(degrees)
+        } else {
+            1.0
+        };
+        let product = settle * speed;
+        scale(v, if time - product >= 0.0 { time } else { product })
+    }
+
+    ///82D4A0C0 body lean. Returns the skateboard offset rows when the lean
+    ///exceeds two degrees (orientation refreshed for 15 updates).
+    pub fn lean(&mut self, s: &Settings, push_speed: bool) -> Option<Frame> {
+        let side = if self.angle_940 >= 0.0 { 1.0 } else { -1.0 };
+        let degrees = (self.angle_940 * side) * f32::from_bits(0x4265_2ee1);
+        let radians = f32::from_bits(0x3c8e_fa35);
+        let mut target = s.lean_30fd.evaluate(degrees) * radians * side;
+        if push_speed {
+            target = 0.0;
+        }
+        let limit = 10.0 * radians;
+        self.lean_944 += clamp((target - self.lean_944) * 0.25, -limit, limit);
+        if !(self.lean_944.abs() > 2.0 * radians) {
+            return None;
+        }
+        let (sin, cos) = crate::trigonometry::sin_cos(self.lean_944);
+        Some([[cos, 0.0, -sin, cos], [0.0, 1.0, 0.0, 0.0], [sin, 0.0, cos, sin], [0.0; 4]])
+    }
+
+    ///82D47BD8 release speed and push-contact latch. The vehicle reaction
+    ///impulses of this function have no GTA counterpart and are not applied.
+    pub fn release_speed(&mut self, push_contact: bool) {
+        if self.flags_1345 & 0x10 == 0 {
+            let record_scale = self.record().scalar(240);
+            let boost = (200.0 / (1.0 / record_scale)).min(3.5);
+            self.release_speed_996 = (8.0 - self.speed_832).max(0.0).min(boost) + self.speed_832;
+            if push_contact {
+                self.flags_1345 |= 0x10;
+            }
+        } else if !push_contact {
+            self.flags_1345 &= !0x10;
+        }
+    }
+    ///82D479C8 brake latch (vehicle brake impulse not applied in GTA).
+    pub fn brake(&mut self, brake: f32) {
+        self.flags_1345 &= !8;
+        if brake != 0.0 && length(self.line_velocity_752) > f32::from_bits(0x3780_0000) {
+            self.flags_1345 |= 8;
+        }
+    }
+
+    ///82D4AFB8 exit sequencing; returns the release forces (tag 6, point 0).
+    pub fn exit(&mut self, s: &Settings, grab_held: bool, mass: f32) -> [Option<V>; 2] {
+        if !grab_held {
+            self.phase_1324 = 4;
+        }
+        if !matches!(self.phase_1324, 0 | 3 | 4)
+            && self.released_1328_1332 == [1, 1]
+            && self.timer_1020 <= 0.0
+        {
+            self.phase_1324 = 4;
+            self.flags_1344 = (self.flags_1344 & !0x70) | 0x10;
+        }
+        let mut force = [None; 2];
+        if self.phase_1324 == 4 {
+            if self.exit_cooldown_1016 <= 0.0 {
+                self.exit_cooldown_1016 = s.exit_cooldown_6595;
+            }
+            if self.release_counter_1320 == 1 {
+                if self.flags_1344 & 0x40 != 0 {
+                    let f = (-self.speed_832)
+                        .max(self.lateral_velocity_856 + s.release_inner_58b6)
+                        .min(0.0);
+                    force[0] = Some(self.release_force(f, mass));
+                }
+                if self.flags_1344 & 0x20 != 0 {
+                    let f = self.lateral_velocity_856 + s.release_outer_8524;
+                    force[1] = Some(self.release_force(f, mass));
+                }
+            }
+            self.release_counter_1320 += 1;
+            if self.release_counter_1320 > 3 {
+                self.flags_1344 |= 0x10;
+            }
+        } else {
+            self.release_counter_1320 = 0;
+        }
+        if self.kind_1312 == 2 {
+            let rates = self.record_1024.as_ref().map_or([0.0; 4], |r| r.vector(144));
+            if rates[0] * rates[0] + rates[2] * rates[2] > 1.0 {
+                self.flags_1344 |= 0x10;
+            }
+        }
+        force
+    }
+    fn release_force(&self, f: f32, mass: f32) -> V {
+        scale(scale(scale(self.grab_direction_624, f), mass), reciprocal(STEP))
+    }
+    ///End of Update82D477C0.
+    pub fn finish(&mut self) {
+        self.flags_1345 &= 0x7f;
+    }
+
+    ///Fill82D4C078. `board_y` is Processed+176 y.
+    pub fn fill(&self, board_y: f32) -> Fill {
+        let hand = line_point(&self.frames[1], self.hand_908);
+        Fill {
+            grabbing_304: self.flags_1344 & 0x10 == 0 && self.flags_1344 & 0x80 != 0,
+            animation_132: self.hand_height_988,
+            animation_136: self.hand_step_912 * RATE,
+            animation_140: self.hand_flags_984,
+            ground_280: hand[1] - board_y,
+            ground_284: self.absorb_956,
+            ground_288: self.normalized_936,
+            ground_292: self.exit_cooldown_1016,
+            ground_308: self.release_speed_996,
+            state_36: self.kind_1312,
+            state_40: self.id_1316,
+            state_53: (self.flags_1345 >> 3) & 1 != 0,
+        }
+    }
+}
+#[derive(Clone, Copy, Debug)]
+pub struct PullInput {
+    ///Processed+2612 signed speed and +2660 total mass.
+    pub signed_speed: f32,
+    pub mass: f32,
+    pub root_z: f32,
+    pub mirrored: bool,
+    pub world_grab_z: f32,
+}
+///Apply `inner` first, then `outer`.
+fn compose(outer: &Frame, inner: &Frame) -> Frame {
+    let rotate = |v: V| madd(outer[2], v[2], madd(outer[1], v[1], scale(outer[0], v[0])));
+    [rotate(inner[0]), rotate(inner[1]), rotate(inner[2]), point(outer, inner[3])]
+}

+    }
+    k.pull_force_816 = pull;
+    physics.board.forces_mut().append(QueuedPointForce {
+        tag: 6,
+        force_world: xyz(pull),
+        point_body: Vector3::ZERO,
+    });
+    physics.board.forces_mut().append(QueuedPointForce {
+        tag: 1,
+        force_world: Vector3::new(friction[0], friction[1], friction[2]),
+        point_body: Vector3::new(friction[4], friction[5], friction[6]),
+    });
+    k.time_992 += f32::from_bits(0x3c88_8889);
+    Ok(())
+}

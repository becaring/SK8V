diff --git a/crates/skate-host/src/graph_host/motion_skitch.rs b/crates/skate-host/src/graph_host/motion_skitch.rs
new file mode 100644
--- /dev/null
+++ b/crates/skate-host/src/graph_host/motion_skitch.rs
@@ -0,0 +1,179 @@
+//! Skitch MotionGraph behaviours (TU3): EnterSkitchingBehaviour VT82320F10
+//! (Begin82BBC538, Update82BBC5E0), SkitchingBehaviour VT82320ED4 (Begin
+//! 82BBC2D8, Update82BBC390) and SkitchShimmyingBehaviour VT82320F4C (Begin
+//! 82BBC7C8, Update82BBC858, End82BBCAB8). All read the anim_skitching/default
+//! layout and the completed Skitch/Ground physical publication.
+use super::motion_animation::MotionAnimation;
+use skate_core::{
+    animation::{
+        channel_playback::ChannelSettings,
+        playback_parameters::{AttributeSink, SettableAttribute},
+        skeleton_input::name::encode,
+    },
+    point_graph::PointGraph,
+};
+use skate_data::collections::Collections;
+
+const LEFT: &str = "SKCH_2H_SHIMMY_LEFT_CHANNEL"; //830C0010, initializer82F874E8
+const RIGHT: &str = "SKCH_2H_SHIMMY_RIGHT_CHANNEL"; //830BE0DC, initializer82F87500
+
+///anim_skitching/default by layout offset.
+#[derive(Clone, Copy, Debug)]
+pub struct Settings {
+    ///+0 PointNegGraphData8: absorb response.
+    pub absorb: PointGraph<8>,
+    pub reach_min_80: f32,
+    pub shimmy_min_84: f32,
+    pub shimmy_max_88: f32,
+    pub reach_max_96: f32,
+    pub crouch_offset_100: f32,
+}
+impl Settings {
+    pub fn load(d: &Collections) -> Result<Self, String> {
+        let class = "anim_skitching";
+        let f = |name: &str| d.float(class, "default", name);
+        let w = d.words::<20>(class, "default", "Hash_1C04030E5B00A8EA")?.map(f32::from_bits);
+        Ok(Self {
+            absorb: PointGraph { x: w[4..12].try_into().unwrap(), y: w[12..20].try_into().unwrap() },
+            reach_min_80: f("Hash_8738E31E171E2A87")?,
+            shimmy_min_84: f("Hash_B2D3A764E1D86D13")?,
+            shimmy_max_88: f("Hash_F146CFA3B03529A5")?,
+            reach_max_96: f("LongSkitchIntoReachTime")?,
+            crouch_offset_100: f("Hash_6E6EFE7CF9BEF4B8")?,
+        })
+    }
+}
+
+///Completed PhysOut fields the behaviours read (Animation56, Ground32).
+#[derive(Clone, Copy, Debug, Default)]
+pub struct Physical {
+    pub hand_height_132: f32,
+    pub hand_speed_136: f32,
+    pub time_to_skitch_276: f32,
+    pub hand_height_280: f32,
+    pub absorb_284: f32,
+    pub release_speed_308: f32,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Kind {
+    Enter,
+    Skitching,
+    ///Authored `direction`: left1, right2.
+    Shimmy(u32),
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+pub struct State {
+    i8: f32,
+    i12: f32,
+    i16: f32,
+}
+
+fn fsel(test: f32, a: f32, b: f32) -> f32 {
+    if test >= 0.0 { a } else { b }
+}
+fn set(animation: &mut MotionAnimation, name: &[u8], value: f32) {
+    animation.set_attribute(SettableAttribute {
+        name: encode(name),
+        value,
+        normalized: false,
+        sequence_id: -1,
+    });
+}
+
+impl State {
+    pub fn begin(&mut self, kind: Kind, s: &Settings, p: &Physical) {
+        match kind {
+            Kind::Enter => {
+                self.i8 = p.hand_height_132;
+                self.i12 = 0.0;
+                self.i16 = -1.0;
+            }
+            Kind::Skitching => {
+                self.i8 = p.hand_height_132;
+                self.i12 = s.absorb.evaluate(p.absorb_284);
+            }
+            Kind::Shimmy(_) => self.i8 = p.hand_speed_136,
+        }
+    }
+
+    pub fn update(
+        &mut self,
+        kind: Kind,
+        s: &Settings,
+        p: &Physical,
+        animation: &mut MotionAnimation,
+    ) -> Result<(), String> {
+        match kind {
+            Kind::Enter => {
+                let crouch = p.hand_height_280 + s.crouch_offset_100;
+                let time = animation.current_time()?;
+                let mut remaining = animation.current_length()?;
+                let left = 1.0 - time / remaining;
+                if !(left <= 0.0) {
+                    remaining = p.time_to_skitch_276 / left;
+                }
+                let over = remaining - s.reach_min_80;
+                let span = s.reach_max_96 - s.reach_min_80;
+                let over = fsel(-over, 0.0, over);
+                let mut f = fsel(span - over, over, span) / span;
+                if !(self.i16 < 0.0) {
+                    let (lo, hi) = (self.i16 - 0.1, self.i16 + 0.1);
+                    let low = fsel(lo - f, lo, f);
+                    f = fsel(hi - low, low, hi);
+                }
+                self.i16 = f;
+                set(animation, b"Crouch", crouch);
+                set(animation, b"reachspeed", 1.0 - f);
+            }
+            Kind::Skitching => {
+                let crouch = p.hand_height_280 + s.crouch_offset_100;
+                let g = s.absorb.evaluate(p.absorb_284);
+                let (lo, hi) = (self.i12 - 0.04, self.i12 + 0.04);
+                let low = fsel(lo - g, lo, g);
+                self.i12 = fsel(hi - low, low, hi);
+                set(animation, b"Crouch", crouch);
+                set(animation, b"PushSpeed", p.release_speed_308);
+                set(animation, b"absorbspeed", self.i12);
+            }
+            Kind::Shimmy(direction) => {
+                let magnitude = p.hand_speed_136.abs();
+                let m = fsel(s.shimmy_min_84 - magnitude, s.shimmy_min_84, magnitude);
+                let m = fsel(s.shimmy_max_88 - m, m, s.shimmy_max_88);
+                self.i8 = if m > s.shimmy_min_84 {
+                    (m - s.shimmy_min_84) / (s.shimmy_max_88 - s.shimmy_min_84)
+                } else {
+                    0.0
+                };
+                let (play, other) = if direction == 1 { (LEFT, RIGHT) } else { (RIGHT, LEFT) };
+                let has_play = animation.channels.has(play);
+                if animation.channels.has(other) {
+                    animation.channels.end(other);
+                }
+                if !has_play {
+                    animation.new_channel(play, play, ChannelSettings {
+                        priority: 0,
+                        keep_alive: true,
+                        mirrored: false,
+                        speed: 1.0,
+                        blend_in: 0.2,
+                        hold_during_blend_in: false,
+                        blend_out: 0.2,
+                        hold_during_blend_out: false,
+                        use_attributes: false,
+                    })?;
+                }
+                set(animation, b"ShimmySpeed", self.i8);
+            }
+        }
+        Ok(())
+    }
+
+    pub fn end(&mut self, kind: Kind, animation: &mut MotionAnimation) {
+        if let Kind::Shimmy(_) = kind {
+            animation.channels.end_with(LEFT, 0.3, false);
+            animation.channels.end_with(RIGHT, 0.3, false);
+        }
+    }
+}

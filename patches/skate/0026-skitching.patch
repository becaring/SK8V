+#[test]
+fn held_line_settles_into_phase_one_and_latches_grab() {
+    let s = settings();
+    let mut k = Skitch::default();
+    k.enter(&s, record(3.0));
+    assert_eq!((k.kind_1312, k.id_1316), (1, 0x8000_0005));
+    let mut z = 3.0 - 1.2;
+    for tick in 0..30 {
+        z += 5.0 / 60.0;
+        k.begin(true);
+        k.track(&s, record(3.0 + 5.0 * (tick + 1) as f32 / 60.0), &observations(z));
+        k.steer(&s, [0.0, 0.0, 1.0, 0.0]);
+        assert!(k.exit(&s, true, 70.0).iter().all(Option::is_none));
+        k.finish();
+    }
+    assert_eq!(k.phase(), 1);
+    assert!(k.flags_1345 & 0x80 == 0);
+    assert!((k.half_length_928 - 1.0).abs() < 1e-5);
+    assert!((k.along_836 - 0.1).abs() < 1e-3);
+    //Board trails the bar along +z: the pull points forward.
+    assert!(k.pull_direction_784[2] > 0.99);
+    let fill = k.fill(0.0);
+    assert!(fill.grabbing_304);
+    assert_eq!((fill.state_36, fill.state_40), (1, 0x8000_0005));
+    let pull = k.pull(&s, PullInput { signed_speed: 5.0, mass: 70.0, root_z: 0.0,
+        mirrored: false, world_grab_z: 0.0 });

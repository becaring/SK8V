+//! Vector/frame helpers shared by the Skitch functions. Frames are four rows
+//! (three axes and a position); points map as row0*x + row1*y + row2*z + row3.
+use super::{Frame, V};
+use crate::player::offboard::grab_scene::Record;
+
+pub(super) const STEP: f32 = f32::from_bits(0x3c88_8889); //1/60, 820849C8.
+pub(super) const RATE: f32 = 60.0;
+
+pub(super) fn dot(a: V, b: V) -> f32 {
+    a[2].mul_add(b[2], a[1].mul_add(b[1], a[0] * b[0]))
+}
+pub(super) fn sub(a: V, b: V) -> V {
+    std::array::from_fn(|i| a[i] - b[i])
+}
+pub(super) fn add(a: V, b: V) -> V {
+    std::array::from_fn(|i| a[i] + b[i])
+}
+pub(super) fn scale(a: V, k: f32) -> V {
+    a.map(|v| v * k)
+}
+///a*k + b.
+pub(super) fn madd(a: V, k: f32, b: V) -> V {
+    std::array::from_fn(|i| a[i].mul_add(k, b[i]))
+}
+pub(super) fn cross(a: V, b: V) -> V {
+    [
+        (-a[2]).mul_add(b[1], a[1] * b[2]),
+        (-a[0]).mul_add(b[2], a[2] * b[0]),
+        (-a[1]).mul_add(b[0], a[0] * b[1]),
+        0.0,
+    ]
+}
+fn rsqrt(d: f32) -> f32 {
+    let mut r = d.sqrt().recip();
+    for _ in 0..2 {
+        r = (r * 0.5).mul_add((-d).mul_add(r * r, 1.0), r);
+    }
+    r
+}
+///vmsum3fp + rsqrte with two refinements; vsel returns zero for zero input.
+pub(super) fn length(v: V) -> f32 {
+    let d = dot(v, v);
+    if d == 0.0 { 0.0 } else { d * rsqrt(d) }
+}
+///The native callers multiply by rsqrte without a zero guard.
+pub(super) fn normalize(v: V) -> V {
+    scale(v, rsqrt(dot(v, v)))
+}
+pub(super) fn reciprocal(v: f32) -> f32 {
+    let mut r = v.recip();
+    for _ in 0..2 {
+        r = r.mul_add((-r).mul_add(v, 1.0), r);
+    }
+    r
+}
+///Component of `v` orthogonal to the unit normal.
+pub(super) fn reject(v: V, n: V) -> V {
+    sub(v, scale(n, dot(v, n)))
+}
+pub(super) fn point(f: &Frame, p: V) -> V {
+    madd(f[2], p[2], madd(f[1], p[1], madd(f[0], p[0], f[3])))
+}
+///Point at `along` on a line frame's row0 axis.
+pub(super) fn line_point(f: &Frame, along: f32) -> V {
+    madd(f[0], along, f[3])
+}
+///82D48148 relative transform: points attached to `p` carried onto `q`.
+pub(super) fn relative(p: &Frame, q: &Frame) -> Frame {
+    let mut out = [[0.0; 4]; 4];
+    for i in 0..3 {
+        out[i] = madd(q[2], p[2][i], madd(q[1], p[1][i], scale(q[0], p[0][i])));
+    }
+    let t = [0, 1, 2].map(|i| -dot(p[3], p[i]));
+    out[3] = madd(q[2], t[2], madd(q[1], t[1], madd(q[0], t[0], q[3])));
+    out
+}
+pub(super) fn clamp(v: f32, lo: f32, hi: f32) -> f32 {
+    v.max(lo).min(hi)
+}
+///82BD41B0: scalar division after the guarded length.
+pub(super) fn clamp_point(target: V, origin: V, radius: f32) -> V {
+    let delta = sub(target, origin);
+    let distance = length(delta);
+    if radius >= distance { target } else { madd(delta, radius / distance, origin) }
+}
+///82BD3D90 ClampVectorWithinMaxLength, including the short-vector return.
+pub(super) fn clamp_length(v: V, maximum: f32) -> V {
+    let length = length(v);
+    if !(length >= f32::from_bits(0x3780_0000)) {
+        return v;
+    }
+    let bound = if maximum - length >= -0.0 { length } else { maximum };
+    v.map(|x| (x * bound) * reciprocal(length))
+}
+///8286CD88 product gate and plane rejection, then the shared signed angle.
+pub(super) fn signed_angle(a: V, b: V, axis: V) -> f32 {
+    if !(dot(a, a) * dot(b, b) > f32::from_bits(0x3780_0000)) {
+        return 0.0;
+    }
+    let xyz = |v: V| crate::math::Vector3::new(v[0], v[1], v[2]);
+    crate::riding::collision_response::signed_angle(
+        xyz(reject(a, axis)),
+        xyz(reject(b, axis)),
+        xyz(axis),
+    )
+}
+///Fold into (-pi, pi] with the native 0.159155 turn fraction.
+pub(super) fn wrap(angle: f32) -> f32 {
+    let turns = angle * f32::from_bits(0x3e22_f983);
+    let fraction = turns - turns.floor();
+    (fraction - if fraction > 0.5 { 1.0 } else { 0.0 }) * f32::from_bits(0x40c9_0fdb)
+}
+pub(super) fn sign(v: f32) -> f32 {
+    if v > 0.0 { 1.0 } else if v >= 0.0 { 0.0 } else { -1.0 }
+}
+
+///82D2D550: point at signed distance `d` from the chord middle. Walks the
+///authored local points along the local chord direction; byte200 bit5 selects
+///the reversed parameterisation. Ends are the (possibly swapped) endpoints.
+pub(super) fn at_distance(record: &Record, d: f32) -> V {
+    let half = record.scalar(180);
+    let [a, b] = record.endpoints();
+    if -half >= d {
+        return a;
+    }
+    if d >= half {
+        return b;
+    }
+    let points = record.points();
+    if points.len() <= 1 {
+        return a;
+    }
+    let target = if record.byte(200) & 0x20 != 0 { half - d } else { d + half };
+    let chord = normalize(sub(points[points.len() - 1], points[0]));
+    let mut sum = 0.0;
+    for pair in points.windows(2) {
+        let segment = sub(pair[1], pair[0]);
+        let projection = dot(segment, chord).max(f32::from_bits(0x38d1_b717));
+        sum += projection;
+        if sum > target {
+            let local = sub(pair[1], scale(segment, (sum - target) * reciprocal(projection)));
+            let frame = [0, 16, 32, 48].map(|o| record.vector(o));
+            return point(&frame, local);
+        }
+    }
+    b
+}

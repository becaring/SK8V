@@ -48,3 +48,33 @@ fn airborne_admission_and_projection_keep_the_original_leaf_boundary() {
     assert_eq!(approach_slope_sine(RAIL, [3.0, 0.0, 0.0, 0.0]), 0.0);
     assert_eq!(approach_slope_sine(RAIL, [3.0, 0.01, 0.0, 0.0]), 0.0);

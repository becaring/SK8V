@@ -0,0 +1,16 @@
+//! SkateV ramp-lip rule (overlay patch 0033): a rolling board stalls on a lip
+//! only when it rides up into it below retail's drop-in speed; rolling off a
+//! deck over its lip, riding up into it faster, and an air the board rolled
+//! into (no pop) carry on without grinding. Popped airs grind as in retail.
+use super::Session;
+
+impl Session {
+    /// true (the default) applies the SkateV ramp-lip rule; false restores
+    /// retail grind admission for rolling boards.
+    pub fn set_lip_rule(&mut self, on: bool) {
+        self.skater.player_input.grind.skatev_lip_rule = on;
+    }
+    pub fn lip_rule(&self) -> bool {
+        self.skater.player_input.grind.skatev_lip_rule
+    }
+}

+
+#[test]
+fn skatev_lip_rule_stalls_only_slow_boards_riding_up_into_a_lip() {
+    let rule = |speed: f32, velocity: V| Admission { speed, skatev_lip_rule: true, ..context(100, 100, velocity) };
+    // Rolling slowly off a deck over its lip (level or descending): no stall.
+    for velocity in [[0.2, 0.0, 1.0, 0.0], [0.2, -0.5, 1.0, 0.0]] {
+        let off_deck = rule(1.0, velocity);
+        assert_ne!(off_deck.test(403, RAIL, true).kind, EntryKind::DropIn);
+        assert!(!off_deck.test(403, RAIL, true).allowed);
+    }
+    // Riding slowly up into the lip: the stall stays, for every family.
+    let slow_up = rule(1.0, [0.2, 1.0, 0.5, 0.0]);
+    assert_eq!(slow_up.test(403, RAIL, true), Decision { kind: EntryKind::DropIn, allowed: true });
+    assert_eq!(slow_up.test(401, RAIL, false), Decision { kind: EntryKind::RideFromBelow, allowed: true });
+    // Riding up at speed: no catch, from below or straight into the coping.
+    for velocity in [[0.5, 2.0, 1.0, 0.0], [0.5, 2.0, 0.0, 0.0]] {
+        let fast_up = rule(2.0, velocity);
+        assert!(!fast_up.test(401, RAIL, false).allowed);
+        assert!(!fast_up.test(403, RAIL, true).allowed);
+        assert!(context(100, 100, velocity).test(401, RAIL, false).allowed, "retail admits it");
+    }
+    // Riding along a rail from above and air-to-grind are unchanged.
+    assert!(rule(3.0, [3.0, -0.2, 0.1, 0.0]).test(401, RAIL, false).allowed);
+    let air = Admission { category: 200, state: 201, ..rule(8.0, [0.0, 0.0, 8.0, 0.0]) };
+    assert_eq!(air.test(401, RAIL, false), Decision { kind: EntryKind::AirToGrind, allowed: true });
+    // An air the board rolled into does not grind; retail's does.
+    let rolled = Admission { skatev_rolled_into_air: true, ..air };
+    assert_eq!(rolled.test(401, RAIL, false), Decision { kind: EntryKind::AirToGrind, allowed: false });
+    assert!(Admission { skatev_lip_rule: false, ..rolled }.test(401, RAIL, false).allowed);
+}

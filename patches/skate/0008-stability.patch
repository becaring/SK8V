 }
 pub(crate) fn inverse_length_squared(squared: f32, refinements: usize) -> f32 {
+    // Match the pinned movement_velocity exponent-normalization precedent:
+    // a positive subnormal q has finite rsqrt(q), but r*r overflows during
+    // refinement. Scaling by 2^24 keeps that product representable.
+    let (squared, rescale) = if squared > 0.0 && squared.is_subnormal() {
+        (squared * 16_777_216.0, 4096.0)
+    } else { (squared, 1.0) };
     let mut inverse = native_arithmetic::reciprocal_square_root_estimate(squared);
     for _ in 0..refinements {
         let correction = (-squared).mul_add(inverse * inverse, 1.0);
         inverse = (inverse * 0.5).mul_add(correction, inverse);
     }
-    inverse
+    inverse * rescale
 }
 pub fn length(v: Vector3) -> f32 {
     let squared = dot(v, v);
     let value = squared * inverse_length_squared(squared, 2);
     if squared == 0.0 { 0.0 } else { value }
 }
+
+#[cfg(test)]
+mod stability_tests {
+    use super::*;
+    #[test]
+    fn positive_subnormal_squared_lengths_remain_finite() {
+        for squared in [f32::from_bits(1), 5.63559e-40, f32::from_bits(0x007f_ffff)] {
+            for refinements in [1, 2] {
+                let inverse = inverse_length_squared(squared, refinements);
+                assert!(inverse.is_finite() && inverse > 0.0);
+                assert!((inverse / (1.0 / squared.sqrt()) - 1.0).abs() < 0.00001);
+            }
+        }
+    }
+}
diff --git a/crates/skate-host/src/graph_host/clip_marker_latch.rs b/crates/skate-host/src/graph_host/clip_marker_latch.rs
new file mode 100644
--- /dev/null
+++ b/crates/skate-host/src/graph_host/clip_marker_latch.rs
@@ -0,0 +1,52 @@
+//! Project-owned adapter for the owned TU3 clip-marker request contract.
+//! Raw-image observations: Begin 82BB93E0, Update 82BB94C0, End 82B61BB8.
+//! The multiplier at 822F860C has bits 426FFFFF; the lower bound at 8231A844
+//! has bits 3F800000. See SkateV world-stability evidence for provenance.
+#[derive(Default)]
+pub(super) struct ClipMarkerLatch(i32);
+
+impl ClipMarkerLatch {
+    /// Begin samples the clip clock once. Updates publish that sample only
+    /// while the collected animation tree reports the authored marker.
+    pub(super) fn step(&mut self, phase: u8, clock: Option<(f32, f32)>, marker: bool)
+        -> Result<Option<i32>, &'static str>
+    {
+        match phase {
+            0 => {
+                let (duration, elapsed) = clock.ok_or("clip clock unavailable at marker Begin")?;
+                let frames = (duration - elapsed) * f32::from_bits(0x426f_ffff);
+                if !frames.is_finite() || frames >= 2147483648.0 {
+                    return Err("clip marker Begin cannot represent the frame interval");
+                }
+                self.0 = if frames < 1.0 { 1 } else { frames as i32 };
+                Ok(None)
+            }
+            1 if marker => Ok(Some(self.0)),
+            _ => Ok(None),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn owned_begin_arithmetic_and_update_latching() {
+        for (duration, elapsed, expected) in [(1.,0.,59), (1.,0.25,44), (1.,0.5,29), (0.,0.,1), (0.,2.,1)] {
+            let mut latch = ClipMarkerLatch::default();
+            assert_eq!(latch.step(0,Some((duration,elapsed)),true),Ok(None));
+            assert_eq!(latch.step(1,None,false),Ok(None));
+            for _ in 0..120 { assert_eq!(latch.step(1,None,true),Ok(Some(expected))); }
+            assert_eq!(latch.step(2,None,true),Ok(None));
+        }
+    }
+    #[test]
+    fn reentry_samples_again_and_bad_clock_is_reported() {
+        let mut latch = ClipMarkerLatch::default();
+        latch.step(0,Some((1.,0.)),false).unwrap();
+        latch.step(0,Some((2.,0.)),false).unwrap();
+        assert_eq!(latch.step(1,None,true),Ok(Some(119)));
+        assert!(latch.step(0,None,false).is_err());
+        assert!(latch.step(0,Some((f32::INFINITY,0.)),false).is_err());
+    }
+}

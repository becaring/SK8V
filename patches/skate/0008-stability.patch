+// Animation frames retain VMX scratch/homogeneous W lanes. The portable ground
+// controller's rotate and inverse_rigid operate on geometric XYZ/W=0 frames.
+// Convert once at this ownership boundary, before support velocity differences.
+fn geometric_vector(v: [f32; 4]) -> [f32; 4] { [v[0], v[1], v[2], 0.0] }
+fn geometric_frame(f: [[f32; 4]; 4]) -> [[f32; 4]; 4] { f.map(geometric_vector) }
+
+#[cfg(test)]
+mod geometric_entry_tests {
+    use super::*;
+    #[test]
+    fn scratch_lanes_do_not_enter_ground_support_history() {
+        let frame = [[1.,0.,0.,0.25], [0.,1.,0.,-2.], [0.,0.,1.,1.], [10.,20.,30.,0.11297838]];
+        let output = geometric_frame(frame);
+        for i in 0..4 {
+            assert_eq!(&output[i][..3], &frame[i][..3]);
+            assert_eq!(output[i][3], 0.0);
+        }
+    }
+}

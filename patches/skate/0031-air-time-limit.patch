@@ -0,0 +1,29 @@
+//! SkateV air time (overlay patch 0031). The host's replacement for the state
+//! selector's air-frame teleport, which snaps a skater who stays airborne too
+//! long back to the last checkpoint; GTA drops (building roofs, cliffs) are
+//! much longer than any Skate 3 drop.
+use super::Session;
+
+impl Session {
+    /// Replaces the selector's air-frame teleport limit, in Skate seconds:
+    /// None restores the retail limit; f32::INFINITY removes it.
+    pub fn set_air_time_limit(&mut self, seconds: Option<f32>) {
+        let period = self.period();
+        self.skater.player_state.selector.skatev_max_air_frames =
+            seconds.filter(|t| !t.is_nan() && *t > 0.0).map(|t| {
+                if t.is_finite() && period > 0.0 {
+                    (t / period).ceil().min(i32::MAX as f32) as i32
+                } else {
+                    i32::MAX
+                }
+            });
+    }
+    /// Consecutive airborne frames the selector has counted.
+    pub fn air_frames(&self) -> i32 {
+        self.skater.player_state.selector.air_frames
+    }
+    /// The last `advance` hit the air-frame limit and requested the teleport.
+    pub fn air_teleport_requested(&self) -> bool {
+        self.skater.player_state.selector.request_teleport
+    }
+}

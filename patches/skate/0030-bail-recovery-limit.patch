+//! SkateV bail recovery (overlay patch 0030). The host's replacement for the
+//! automatic-reset time limit, and the WipeoutGround recovery state the host
+//! reads to report why a bail ended.
+use super::Session;
+
+/// WipeoutGround recovery state after the last `advance` (Skate seconds).
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct BailRecovery {
+    /// State+304: time since the wipeout began.
+    pub time: f32,
+    /// State+308: time the body has been at rest ("over").
+    pub settled_time: f32,
+    /// State+324: time since the last contact response.
+    pub response_time: f32,
+    /// State+566: the player pressed WipeOutRecover during this wipeout.
+    pub recover_pressed: bool,
+    /// State+568: a WipeOutRecover press is honoured (settled once, or
+    /// past the original 1.6 s).
+    pub recovery_eligible: bool,
+    /// State+570: the body was impaled.
+    pub impaled: bool,
+    /// State+569: the automatic reset is fading out.
+    pub automatic_pending: bool,
+    /// State+560 >= 0: the teleport countdown has started.
+    pub countdown: bool,
+    /// The time limit in force (the retail value or the host's).
+    pub maximum_time: f32,
+}
+
+impl Session {
+    /// Replaces physics_wipeout TeleportMaxTime: None restores the retail
+    /// value; f32::INFINITY removes the limit.
+    pub fn set_bail_maximum_time(&mut self, maximum_time: Option<f32>) {
+        self.skater.skatev_bail_maximum_time = maximum_time.filter(|t| !t.is_nan() && *t > 0.0);
+    }
+    /// The recovery state of the current (or last) wipeout.
+    pub fn bail_recovery(&self) -> BailRecovery {
+        let runtime = &self.skater.wipeout_state;
+        let s = &runtime.state;
+        BailRecovery {
+            time: s.time,
+            settled_time: s.settled_time,
+            response_time: s.response_time,
+            recover_pressed: s.reset_ever,
+            recovery_eligible: s.recovery_eligible,
+            impaled: s.ever_impaled,
+            automatic_pending: s.teleport_pending,
+            countdown: s.teleport_countdown >= 0,
+            maximum_time: self
+                .skater
+                .skatev_bail_maximum_time
+                .unwrap_or(runtime.retail_bail_maximum_time()),
+        }
+    }
+}

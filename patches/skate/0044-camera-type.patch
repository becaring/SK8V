+//! SkateV camera choice (overlay patch 0044): retail's stock camera graph picks
+//! its CameraLow or CameraHigh branch by `IsCameraTypeActive`.
+use super::Session;
+use crate::physics::camera_output::CAMERA_TYPE;
+use std::sync::atomic::Ordering;
+
+impl Session {
+    /// 0 Low, 1 High. False (unchanged) otherwise.
+    pub fn set_camera_type(&mut self, camera_type: u32) -> bool {
+        if camera_type > 1 { return false; }
+        CAMERA_TYPE.store(camera_type, Ordering::Relaxed);
+        true
+    }
+}

+/// A walkable face passes over `point` at or above it (1 cm tolerance).
+fn walkable_above(point: Vector3, candidates: &[usize], triangles: &[WorldTriangle], bounds: &[Bounds]) -> bool {
+    candidates.iter().any(|&i| {
+        let other = &triangles[i];
+        let n = other.triangle.feature.normal;
+        if n.y < IMPORTED_SEAM_MIN_UP {
+            return false;
+        }
+        let b = bounds[i];
+        if point.x < b.min.x - 0.001 || point.x > b.max.x + 0.001 || point.z < b.min.z - 0.001 || point.z > b.max.z + 0.001 {
+            return false;
+        }
+        let p = other.triangle.vertices;
+        let height = p[0].y - (n.x * (point.x - p[0].x) + n.z * (point.z - p[0].z)) / n.y;
+        height >= point.y - 0.01 && point_in_floor_triangle(point, p)
+    })
+}

+/// SkateV wheel-scale steps (owner runs 2026-10-02: snags on lips that read
+/// as 1..2 mm by the pagoda grass bed, whose collision stands 1.8 cm proud;
+/// wheels stuck at skate-park ramp tops, whose decks stand 5..20 mm above
+/// the ramps). Skate's contact answer for a step is a sideways push from its
+/// edge, so a wheel stops dead at any lip. Board wheels are spheres of the
+/// retail radius (3.1 cm): a step whose top lies below the wheel centre is
+/// one the wheel rolls over with speed. Its lateral contact is dropped; the
+/// step top's own contacts lift the wheel, so the bump stays. A step above
+/// the wheel centre (curbs, ledges, risers of 3.1 cm and more) keeps its
+/// contact and remains an obstacle. Trucks and deck, touching with their
+/// underside, ignore a nearly horizontal push from a lip that is no higher
+/// than the touching point (less r(1 - 0.9) = 3.1 mm, the height a retail
+/// wheel climbs as a walkable slope). Walls and anything without a walkable
+/// top in reach keep their contacts.
+fn wheel_scale_step(
+    body: CollisionBody,
+    board_point: Vector3,
+    contact: Vector3,
+    contact_normal: Vector3,
+    candidates: &[usize],
+    triangles: &[WorldTriangle],
+    bounds: &[Bounds],
+) -> bool {
+    // HOST A/B diagnostic: SKATEV_WHEEL_STEPS=0 disables the rule.
+    static OFF: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    if *OFF.get_or_init(|| std::env::var("SKATEV_WHEEL_STEPS").is_ok_and(|v| v == "0")) {
+        return false;
+    }
+    let lateral = contact_normal.x.hypot(contact_normal.z);
+    if lateral < 0.5 {
+        return false;
+    }
+    let r = RETAIL_WHEEL_RADIUS;
+    let (dx, dz) = (contact_normal.x / lateral, contact_normal.z / lateral);
+    // The step's walkable top just beyond the contact (away from the board).
+    let beyond = (contact.x - dx * 0.01, contact.z - dz * 0.01);
+    let Some(top) = walkable_surfaces(beyond.0, beyond.1, candidates, triangles, bounds)
+        .map(|(h, _, _)| h)
+        .filter(|h| *h >= contact.y - 0.01 && *h <= contact.y + 0.05)
+        .max_by(f32::total_cmp)
+    else {
+        return false;
+    };
+    match body {
+        CollisionBody::Board(BodyId::RightFrontWheel | BodyId::LeftFrontWheel | BodyId::RightBackWheel | BodyId::LeftBackWheel) => {
+            // The wheel sphere's centre: the touching point one radius back
+            // along the contact normal.
+            let centre = board_point.y + contact_normal.y * r;
+            top < centre
+        }
+        _ => board_point.y >= top - r * (1.0 - IMPORTED_SEAM_MIN_UP) && contact_normal.y < 0.25,
+    }
+}

+// SkateV wheel-scale steps.
+fn wheel_step(triangles: &[WorldTriangle], body: CollisionBody, board: [f32; 3], contact: [f32; 3], normal: [f32; 3]) -> bool {
+    let bounds: Vec<Bounds> = triangles.iter().map(|t| Bounds::from_points(t.triangle.vertices).unwrap()).collect();
+    let candidates: Vec<usize> = (0..triangles.len()).collect();
+    let n = Vector3::new(normal[0], normal[1], normal[2]);
+    let len = (n.x * n.x + n.y * n.y + n.z * n.z).sqrt();
+    wheel_scale_step(
+        body,
+        Vector3::new(board[0], board[1], board[2]),
+        Vector3::new(contact[0], contact[1], contact[2]),
+        Vector3::new(n.x / len, n.y / len, n.z / len),
+        &candidates,
+        triangles,
+        &bounds,
+    )
+}
+fn step_world(h: f32) -> Vec<WorldTriangle> {
+    let mut w: Vec<WorldTriangle> = Vec::new();
+    w.extend(floor(-1., 0., 0.));
+    w.extend(floor(0., 1., h));
+    w.extend(riser_at(0., 0., h));
+    w
+}

+#[test]
+fn wheels_roll_over_steps_below_their_axle_but_not_curbs() {
+    let wheel = CollisionBody::Board(BodyId::RightFrontWheel);
+    let r = RETAIL_WHEEL_RADIUS;
+    // A wheel resting on the road (centre r up), touching the riser at its
+    // equator: a 1.8 cm step (pagoda grass bed) and a 6 mm ramp-top lip pass.
+    for h in [0.018f32, 0.006] {
+        let w = step_world(h);
+        assert!(wheel_step(&w, wheel, [-0.001, r, 0.], [0., h, 0.], [-0.9, -0.4, 0.]), "{h} edge below the axle");
+    }
+    // A 7.5 cm curb: its top is above the wheel centre.
+    let w = step_world(0.075);
+    assert!(!wheel_step(&w, wheel, [-0.001, r, 0.], [0., r, 0.], [-1., 0., 0.]));
+    // Deck: a lip below its underside passes, a riser up to it does not.
+    let deck = CollisionBody::Board(BodyId::Deck);
+    let w = step_world(0.018);
+    assert!(wheel_step(&w, deck, [-0.05, 0.088, 0.], [0., 0.018, 0.], [-1., 0.1, 0.]));
+    let w = step_world(0.075);
+    assert!(!wheel_step(&w, deck, [-0.05, 0.06, 0.], [0., 0.06, 0.], [-1., 0., 0.]));
+}

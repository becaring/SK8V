+//! SkateV d-pad gestures (overlay patch 0045): retail's player gesture
+//! preferences, which CharacterGesture reads when a gesture starts.
+use super::Session;
+
+impl Session {
+    /// Catalog indices (0..37) for d-pad [up, down, left, right]; None turns gestures off.
+    /// False (unchanged) when an index is out of range.
+    pub fn set_gestures(&mut self, gestures: Option<[u32; 4]>) -> bool {
+        if gestures.is_some_and(|g| g.iter().any(|v| *v >= 37)) { return false; }
+        self.physics.set_gesture_preferences(gestures);
+        true
+    }
+}

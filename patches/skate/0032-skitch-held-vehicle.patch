+//! SkateV skitching (overlay patch 0032): which host vehicle the rider holds,
+//! so the host can leave that vehicle to GTA (Skate's reaction impulses on the
+//! towing vehicle are not applied, and neither are contact pushes on it).
+use super::Session;
+use skate_core::player::state::PhysicalStateId;
+
+impl Session {
+    /// The grab-line tag (the vehicle's dynamic tag) of the vehicle being
+    /// skitched, while the rider is in the Skitching state.
+    pub fn skitch_held_tag(&self) -> Option<u32> {
+        matches!(self.skater.player_state.current(), PhysicalStateId::Skitching)
+            .then_some(self.skater.skitch.skitch.id_1316)
+            .filter(|tag| *tag != 0)
+    }
+}

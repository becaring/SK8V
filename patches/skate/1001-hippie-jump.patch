+#[test]
+fn a_bigger_hippie_jump_takes_off_faster() {
+    let launch = |height_scale: f32| {
+        let (mut state, mut manager) = (State::default(), Manager::default());
+        state.enter(&mut manager, Entry { height_scale, ..entry() });
+        manager.trajectory_32.velocity[1]
+    };
+    assert!(launch(1.6) > launch(1.) * 1.2, "higher, to clear a car");
+}

+/// SkateV lifecycle (patch 0007): the checkpoint history restarted at a new
+/// entry point, exactly as `load` starts it for a new session there. SkateV
+/// relocates the one session across Los Santos while only a working set of
+/// collision around the player exists; history from an earlier entry lies
+/// outside it, where `Scene::location` (normal-world mode: always true) would
+/// still accept it. Settings are untouched.
+impl Runtime {
+    pub(crate) fn skatev_restart(&mut self, transform: Matrix, stance: u32) {
+        self.history = History::new(Candidate {
+            transform,
+            stance,
+            offboard: false,
+            score: 0.,
+        });
+        self.measurements = 0;
+    }
+}

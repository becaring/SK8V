+    ///SkeletonIK FillPhysOut82BF20C8, PhysOutSkeleton602/603: each hand's
+    ///retained deck-space part position (IK1840/1904, limbs 2 and 3) lies
+    ///strictly inside the deck box (IK3168, 0, IK3176) grown by layout32
+    ///IKOffPadding. Native tests Y, X, Z, each as bound > p && p > -bound.
+    pub fn hands_over_deck(&self) -> [bool; 2] {
+        let s = &self.settings;
+        let base = [s.deck_half_width, 0.0, s.deck_total_half_length, 0.0];
+        let bound: [f32; 4] = core::array::from_fn(|i| base[i] + s.blend.hand_outer_padding[i]);
+        [2, 3].map(|limb| {
+            let p = self.state.limbs[limb].part_position;
+            [1, 0, 2].into_iter().all(|i| bound[i] > p[i] && p[i] > -bound[i])
+        })
+    }

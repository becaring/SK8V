+pub(crate) mod skatev_dynamic_tests {
+    use super::*;
+    use skate_core::physics::{board_world::WorldTriangle, contact::RetailContactMaterial};
+    use skate_core::player::offboard::ground_query::{GroundQueryPacket, GroundQueryScene, Line, QueryContext};
+
+    pub(crate) fn moving_entity_is_visible_to_biped_ground_air_and_support_queries() {
+        let mut world = BoardWorld::with_query_metadata(vec![], QueryMetadata {
+            packed_surfaces: vec![], meshes: vec![], static_edges: vec![], island_flags: 0,
+        }).unwrap();
+        let t = WorldTriangle::from_vertices([
+            Vector3::new(-5., 1., -5.), Vector3::new(-5., 1., 5.), Vector3::new(5., 1., -5.),
+        ], RetailContactMaterial { static_friction: 0.5, dynamic_friction: 0.5, restitution: 0. },
+            0, 0x1e1, [-1.; 3], 0.).unwrap();
+        world.set_dynamic(vec![t], vec![0xA1234567]);
+        let line = Line { start: Vector3::new(-1., 3., -1.), end: Vector3::new(-1., -1., -1.), radius: 0. };
+        assert!(world.query_swept_line(line.start, line.end, 0.).unwrap().is_some(), "board sees the entity");
+        let air = StaticScene::new(&world).unwrap().lines(&[line], -1).unwrap();
+        assert_eq!(air[0].as_ref().map(|h| h.packed_surface), Some(0), "off-board air must see it too; entity tag is not a surface");
+        let packet = GroundQueryPacket {
+            context: QueryContext { selection_flags_2948: 0, matching_id_2952: -1 },
+            center: Vector3::ZERO, up: Vector3::new(0., 1., 0.), tangent: Vector3::new(0., 0., 1.), lines: [line; 7],
+        };
+        use crate::physics::offboard::ground_query::{with_world_scene, PrimaryEdges};
+        let ground = with_world_scene(&world, PrimaryEdges::Normal { dynamic: &[], vehicles: &[] }, &[],
+            |scene| scene.query_lines(&packet)).unwrap();
+        assert!(ground.iter().all(Option::is_some), "walking probes must see the same moving geometry");
+        let support = crate::physics::offboard::contact_queries::query(&world,
+            crate::physics::offboard::contact_queries::Probe { start: lanes(line.start), end: lanes(line.end), radius: 0. }, 7).unwrap();
+        assert!(support.is_some(), "biped support must not fall through the entity");
+        assert!(!StaticScene::new(&world).unwrap().nearby(QueryPool::Ground, [-1., 1., -1., 0.], 0.5, -1).unwrap().is_empty());
+        world.set_dynamic(vec![], vec![]);
+        assert!(StaticScene::new(&world).unwrap().lines(&[line], -1).unwrap()[0].is_none(), "removed entities leave no ghost collider");
+    }
+}

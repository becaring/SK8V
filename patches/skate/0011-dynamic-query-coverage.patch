diff --git a/crates/skate-core/src/physics/board_world/dynamic_queries.rs b/crates/skate-core/src/physics/board_world/dynamic_queries.rs
new file mode 100644
--- /dev/null
+++ b/crates/skate-core/src/physics/board_world/dynamic_queries.rs
@@ -0,0 +1,75 @@
+//! SkateV's moving-geometry view for every scene adapter. Static hierarchy,
+//! ordering, groups and surfaces remain unchanged. Dynamic entities are
+//! world-space kinematic geometry; host handles never become surface codes
+//! or Skate body indices.
+use super::{BoardWorld, WorldTriangle};
+use super::query_metadata::{Bounds, QueryMesh, QueryPool};
+use crate::{math::Vector3, physics::drive_frames::RetailAffineTransform};
+use std::ops::Range;
+
+impl BoardWorld {
+    pub(super) fn refresh_dynamic_query_metadata(&mut self) {
+        self.dynamic_surfaces.clear();
+        self.dynamic_surfaces.resize(self.dynamic.len(), 0);
+        self.dynamic_mesh = Bounds::from_points(self.dynamic_bounds.iter().flat_map(|b| [b.min, b.max]))
+            .map(|bounds| QueryMesh {
+                triangle_range: self.triangles.len()..self.triangles.len() + self.dynamic.len(),
+                local_to_world: RetailAffineTransform::IDENTITY,
+                world_to_local: RetailAffineTransform::IDENTITY,
+                local_bounds: bounds,
+                matching_group: -1,
+                rejection_flags: 0,
+                geometry: 0,
+                pool: QueryPool::Ground,
+            });
+    }
+
+    /// Static candidates first, moving entities second, in stable supplied order.
+    /// Indices in the second segment are only valid through query_triangle(s).
+    pub fn scene_line_candidates(&self, start: Vector3, end: Vector3, radius: f32)
+        -> impl Iterator<Item = (usize, &WorldTriangle)>
+    {
+        let bounds = self.line_candidate_bounds(start, end, radius);
+        let moving = self.dynamic.iter().zip(&self.dynamic_bounds).enumerate()
+            .filter(move |(_, (_, b))| bounds.is_none_or(|a| a.overlaps(b.expanded(1e-3))))
+            .map(|(i, (t, _))| (self.triangles.len() + i, t));
+        self.line_candidates(start, end, radius).chain(moving)
+    }
+
+    pub fn scene_mesh_candidates(&self, bounds: Option<Bounds>)
+        -> Result<Vec<(usize, &QueryMesh)>, &'static str>
+    {
+        let metadata = self.query_metadata()?;
+        let mut meshes: Vec<_> = self.candidate_mesh_indices(bounds)?.into_iter()
+            .map(|i| (i, &metadata.meshes[i])).collect();
+        if let Some(mesh) = &self.dynamic_mesh {
+            if bounds.is_none_or(|b| b.overlaps(mesh.local_bounds.expanded(1e-3))) {
+                meshes.push((metadata.meshes.len(), mesh));
+            }
+        }
+        Ok(meshes)
+    }
+
+    pub fn query_triangle(&self, index: usize) -> &WorldTriangle {
+        if index < self.triangles.len() { &self.triangles[index] }
+        else { &self.dynamic[index - self.triangles.len()] }
+    }
+
+    /// Ranges come from scene_mesh_candidates and never span both segments.
+    pub fn query_triangles(&self, range: Range<usize>) -> &[WorldTriangle] {
+        if range.start < self.triangles.len() { &self.triangles[range] }
+        else { &self.dynamic[range.start - self.triangles.len()..range.end - self.triangles.len()] }
+    }
+
+    pub fn query_surfaces(&self, range: Range<usize>) -> &[u16] {
+        if range.start < self.triangles.len() {
+            &self.query_metadata.as_ref().expect("scene metadata validated by caller").packed_surfaces[range]
+        } else {
+            &self.dynamic_surfaces[range.start - self.triangles.len()..range.end - self.triangles.len()]
+        }
+    }
+
+    pub fn query_surface(&self, index: usize) -> u16 {
+        self.query_surfaces(index..index + 1)[0]
+    }
+}

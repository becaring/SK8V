+#[test]
+fn deck_passes_over_faces_a_wheel_radius_below_it() {
+    let deck = CollisionBody::Board(BodyId::Deck);
+    let r = RETAIL_WHEEL_RADIUS;
+    let bump = [Vector3::new(0., 0., 0.), Vector3::new(0., 0.02, 0.02), Vector3::new(0., 0., 1.)];
+    let diagonal = Vector3::new(-0.68, 0.73, 0.);
+    let rolling = Vector3::new(4.7, -0.1, 0.);
+    // A 2 cm coping bump met at 43 degrees under a rolling deck.
+    assert!(deck_clears_face(deck, Vector3::new(0., 0.02 + r, 0.), diagonal, rolling, &bump));
+    // Not when the deck is down at the bump, lands steeply, or rests on it.
+    assert!(!deck_clears_face(deck, Vector3::new(0., 0.02 + r * 0.5, 0.), diagonal, rolling, &bump));
+    assert!(!deck_clears_face(deck, Vector3::new(0., 0.1, 0.), diagonal, Vector3::new(2., -5., 0.), &bump));
+    assert!(!deck_clears_face(deck, Vector3::new(0., 0.1, 0.), Vector3::new(-0.3, 0.95, 0.), rolling, &bump));
+    // Wheels and trucks are left to the wheel-scale step rule.
+    assert!(!deck_clears_face(CollisionBody::Board(BodyId::FrontTruck), Vector3::new(0., 0.1, 0.), diagonal, rolling, &bump));
 }

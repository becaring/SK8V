+/// SkateV deck clearance (patch 0034; owner park, 2026-10-04: a half pipe's
+/// 2 cm coping bump, met by the deck at 43 degrees, stopped a 4.7 m/s drop-in
+/// dead). The deck stands the wheel clearance above the ground the wheels roll
+/// on, yet its fat triangles and Skate's one-tick contact prediction still
+/// report faces lying wholly below it. A face whose highest point is a wheel
+/// radius or more under the deck's touching point is passed over while the
+/// deck moves more sideways than down; support from below (normals within 30
+/// degrees of up, the lateral gate) and landings keep their contacts.
+fn deck_clears_face(body: CollisionBody, board_point: Vector3, contact_normal: Vector3, velocity: Vector3, face: &[Vector3; 3]) -> bool {
+    if !matches!(body, CollisionBody::Board(BodyId::Deck)) || contact_normal.x.hypot(contact_normal.z) < 0.5 {
+        return false;
+    }
+    let highest = face[0].y.max(face[1].y).max(face[2].y);
+    highest <= board_point.y - RETAIL_WHEEL_RADIUS && velocity.y >= -velocity.x.hypot(velocity.z)
+}

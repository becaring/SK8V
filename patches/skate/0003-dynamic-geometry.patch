+    /// SkateV: moving host geometry (Skate space, counterclockwise) for the
+    /// following ticks, built like collision without authored edge data
+    /// (TriangleVolume defaults 0x1e1 / -1 cosines) and the same packed
+    /// surface as the static collision map (0). `tag` identifies the host
+    /// entity in `dynamic_hits` only. Returns the triangles accepted.
+    pub fn set_dynamic_triangles(&mut self, triangles: &[([[f32; 3]; 3], u32)]) -> usize {
+        use skate_core::{math::Vector3, physics::board_world::WorldTriangle};
+        let material = self.physics.floor_material();
+        let (built, entities): (Vec<_>, Vec<_>) = triangles
+            .iter()
+            .filter_map(|(points, tag)| {
+                WorldTriangle::from_vertices(
+                    points.map(|p| Vector3::new(p[0], p[1], p[2])),
+                    material,
+                    0,
+                    0x1e1,
+                    [-1.; 3],
+                    0.,
+                )
+                .map(|t| (t, *tag))
+            })
+            .unzip();
+        let n = built.len();
+        self.physics.world.set_dynamic(built, entities);
+        n
+    }

+//! SkateV: impacts driven by a foreign host's moving bodies (GTA vehicles and
+//! props joining the board/skater solve as attached proxies, skate-host
+//! `host_bodies`), resolved before the shared solve as a two-body rigid
+//! collision between the proxy and the whole board + rider assembly.
+//!
+//! The shared solve meets a fast host body through whichever limb it touches;
+//! its iterations carry only part of that impulse through the skeleton joints
+//! while the host body keeps advancing, so a car drove into and through the
+//! rider. Here the assembly's mass, centre of mass and composite inertia take
+//! the impact at the contact point:
+//!
+//! j = (1 + e) v_closing / (1/M + n.(I^-1 (r x n)) x r + 1/m + n.(I_h^-1 (r_h x n)) x r_h)
+//!
+//! with the contacts' own combined restitution `e`. Each body then gains the
+//! rigid velocity change of the assembly (internal motion is kept), the proxy
+//! loses the opposite impulse for this solve, and the caller returns that
+//! impulse to the host like any solved row.
+//!
+//! Applied only where the host body itself moves into the contact (proxy
+//! surface velocity along the normal > 0) and the assembly closes on it within
+//! this step (separation <= closing * dt): a rider skating into a parked car,
+//! a platform carrying the board and resting contacts stay entirely with the
+//! retail solve. The touching points act through their closing-weighted
+//! middle (a flat face meeting several points pushes through their middle).
+//!
+//! The solve no longer sees these contacts closing, so its rows carry no
+//! impact and the skeleton's collision feedback (bails) would never hear of
+//! it. Each struck skeleton part is therefore reported as the solve would have
+//! at first touch, with the host body's velocity expressed in the rider's
+//! frame before the impact (the feedback measures against post-solve rider
+//! velocity): relative velocity = host - rider before.
+use super::{
+    assembly::BodySnapshot,
+    board_step::{BoardCollision, CollisionBody},
+    skeleton_body::{SkeletonContactBody, SkeletonContactReport},
+};
+use crate::math::{Basis3, Vector3};
+
+type V = [f64; 3];
+type M = [[f64; 3]; 3]; // rows
+
+fn v(a: Vector3) -> V {
+    [a.x as f64, a.y as f64, a.z as f64]
+}
+fn out(a: V) -> Vector3 {
+    Vector3::new(a[0] as f32, a[1] as f32, a[2] as f32)
+}
+fn add(a: V, b: V) -> V {
+    [a[0] + b[0], a[1] + b[1], a[2] + b[2]]
+}
+fn sub(a: V, b: V) -> V {
+    [a[0] - b[0], a[1] - b[1], a[2] - b[2]]
+}
+fn scale(a: V, s: f64) -> V {
+    [a[0] * s, a[1] * s, a[2] * s]
+}
+fn dot(a: V, b: V) -> f64 {
+    a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
+}
+fn cross(a: V, b: V) -> V {
+    [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]
+}
+fn mul(m: &M, a: V) -> V {
+    [dot(m[0], a), dot(m[1], a), dot(m[2], a)]
+}
+/// Rows of a basis whose columns are the body axes.
+fn rows(b: Basis3) -> M {
+    let c = b.columns.map(|c| c.map(|x| x as f64));
+    [[c[0][0], c[1][0], c[2][0]], [c[0][1], c[1][1], c[2][1]], [c[0][2], c[1][2], c[2][2]]]
+}
+fn inverse(m: &M) -> Option<M> {
+    let c = [cross(m[1], m[2]), cross(m[2], m[0]), cross(m[0], m[1])];
+    let det = dot(m[0], c[0]);
+    if !(det.abs() > 1e-12) || !det.is_finite() {
+        return None;
+    }
+    // inverse = adjugate / det; adjugate columns are the row cross products.
+    Some([
+        [c[0][0] / det, c[1][0] / det, c[2][0] / det],
+        [c[0][1] / det, c[1][1] / det, c[2][1] / det],
+        [c[0][2] / det, c[1][2] / det, c[2][2] / det],
+    ])
+}
+
+/// One host-driven impact: the impulse the host body receives (Skate space,
+/// N s) at `point`, and the skeleton reports for the struck parts.
+#[derive(Clone, Debug)]
+pub struct HostImpact {
+    pub proxy: usize,
+    pub point: [f32; 3],
+    pub impulse_on_host: [f32; 3],
+    pub closing: f32,
+    pub restitution: f32,
+    pub assembly_mass: f32,
+    pub reports: Vec<SkeletonContactReport>,
+}
+
+/// `proxies`: the host bodies of this solve, Attached(`proxy_base` + i) in
+/// the contacts. `rider`: every physical board part followed by the
+/// `skeleton_parts` skeleton bodies (Attached(part) in the contacts).
+/// `carried`: the skeleton's animation drive targets, moved with the rider.
+pub fn resolve(
+    proxies: &mut [BodySnapshot],
+    proxy_base: usize,
+    contacts: &[BoardCollision],
+    rider: &mut [&mut BodySnapshot],
+    carried: &mut [BodySnapshot],
+    skeleton_parts: usize,
+    dt: f32,
+) -> Vec<HostImpact> {
+    let mut impacts = Vec::new();
+    if proxies.is_empty() || rider.is_empty() || skeleton_parts > rider.len() {
+        return impacts;
+    }
+    let physical = |b: &BodySnapshot| b.inertia.inverse_mass > 0.0 && b.inertia.inverse_mass.is_finite();
+    // Composite rigid body of the assembly.
+    let (mut mass, mut com, mut momentum) = (0.0f64, [0.0; 3], [0.0; 3]);
+    for b in rider.iter().filter(|b| physical(b)) {
+        let m = 1.0 / b.inertia.inverse_mass as f64;
+        mass += m;
+        com = add(com, scale(v(b.rates.position), m));
+        momentum = add(momentum, scale(v(b.rates.linear_velocity), m));
+    }
+    if !(mass > 0.0) {
+        return impacts;
+    }
+    com = scale(com, 1.0 / mass);
+    let (mut inertia, mut angular) = ([[0.0f64; 3]; 3], [0.0; 3]);
+    for b in rider.iter().filter(|b| physical(b)) {
+        let m = 1.0 / b.inertia.inverse_mass as f64;
+        let r = sub(v(b.rates.position), com);
+        // Own principal inertia in world axes (an unbounded axis adds none).
+        let t = v(b.inertia.inverse_tensor).map(|i| if i > 0.0 && i.is_finite() { 1.0 / i } else { 0.0 });
+        let axes = rows(b.rates.basis);
+        let mut own = [[0.0f64; 3]; 3];
+        for (i, row) in own.iter_mut().enumerate() {
+            for (j, cell) in row.iter_mut().enumerate() {
+                *cell = (0..3).map(|k| axes[i][k] * t[k] * axes[j][k]).sum::<f64>();
+                // Parallel axis.
+                *cell += m * (if i == j { dot(r, r) } else { 0.0 } - r[i] * r[j]);
+            }
+        }
+        for i in 0..3 {
+            for j in 0..3 {
+                inertia[i][j] += own[i][j];
+            }
+        }
+        // Spin about own centre uses the own (not parallel) part only.
+        let mut spin_part = [0.0; 3];
+        let w = v(b.rates.angular_velocity);
+        for (i, s) in spin_part.iter_mut().enumerate() {
+            *s = (0..3).map(|j| (0..3).map(|k| axes[i][k] * t[k] * axes[j][k]).sum::<f64>() * w[j]).sum();
+        }
+        angular = add(angular, add(spin_part, scale(cross(r, v(b.rates.linear_velocity)), m)));
+    }
+    let Some(inverse_inertia) = inverse(&inertia) else {
+        return impacts;
+    };
+    let mut velocity = scale(momentum, 1.0 / mass);
+    let mut spin = mul(&inverse_inertia, angular);
+    let board_parts = rider.len() - skeleton_parts;
+    for proxy in 0..proxies.len() {
+        let body = proxies[proxy];
+        let x = v(body.rates.position);
+        let host_inverse_mass = body.inertia.inverse_mass as f64;
+        let host_inverse_inertia = rows(body.rates.world_inverse_inertia);
+        let (mut weight, mut sum_n, mut sum_a, mut sum_b, mut sum_e) = (0.0f64, [0.0; 3], [0.0; 3], [0.0; 3], 0.0f64);
+        let mut struck = Vec::new();
+        for c in contacts {
+            if c.body_b != CollisionBody::Attached(proxy_base + proxy) {
+                continue;
+            }
+            let part = match c.body_a {
+                CollisionBody::Board(_) => None,
+                CollisionBody::Attached(part) if part < skeleton_parts => Some(part),
+                _ => continue,
+            };
+            let n = v(c.contact.normal);
+            if !(dot(n, n) > 0.5) {
+                continue;
+            }
+            let (pa, pb) = (v(c.contact.position_on_a), v(c.contact.position_on_b));
+            let host = add(v(body.rates.linear_velocity), cross(v(body.rates.angular_velocity), sub(pb, x)));
+            let own = add(velocity, cross(spin, sub(pa, com)));
+            let closing = dot(sub(host, own), n);
+            let separation = dot(sub(pa, pb), n);
+            if !(dot(host, n) > 0.0 && closing > 0.0 && separation <= closing * dt as f64) {
+                continue;
+            }
+            weight += closing;
+            sum_n = add(sum_n, scale(n, closing));
+            sum_a = add(sum_a, scale(pa, closing));
+            sum_b = add(sum_b, scale(pb, closing));
+            sum_e += c.contact.restitution.clamp(0.0, 1.0) as f64 * closing;
+            if let Some(part) = part {
+                let own_body = &rider[board_parts + part];
+                let lv = |a: Vector3| [a.x, a.y, a.z, 0.0];
+                struck.push((
+                    v(own_body.rates.position),
+                    SkeletonContactReport {
+                        part,
+                        normal: [n[0] as f32, n[1] as f32, n[2] as f32, 0.0],
+                        point: [((pa[0] + pb[0]) * 0.5) as f32, ((pa[1] + pb[1]) * 0.5) as f32, ((pa[2] + pb[2]) * 0.5) as f32, 0.0],
+                        tag: c.contact.tag & 0xffff,
+                        other_group: 0,
+                        other_entity: None,
+                        body_a: SkeletonContactBody {
+                            state_flags: own_body.state_flags,
+                            inverse_mass: own_body.inertia.inverse_mass,
+                            linear_velocity: lv(own_body.rates.linear_velocity),
+                        },
+                        body_b: SkeletonContactBody {
+                            state_flags: body.state_flags,
+                            inverse_mass: body.inertia.inverse_mass,
+                            linear_velocity: lv(body.rates.linear_velocity),
+                        },
+                        side_a: true,
+                        solved_vector: [0.0; 4],
+                    },
+                ));
+            }
+        }
+        let length = dot(sum_n, sum_n).sqrt();
+        if !(weight > 0.0) || !(length > 0.0) {
+            continue;
+        }
+        let (n, pa, pb, e) = (scale(sum_n, 1.0 / length), scale(sum_a, 1.0 / weight), scale(sum_b, 1.0 / weight), sum_e / weight);
+        let host = add(v(body.rates.linear_velocity), cross(v(body.rates.angular_velocity), sub(pb, x)));
+        let closing = dot(sub(host, add(velocity, cross(spin, sub(pa, com)))), n);
+        if !(closing > 0.0) {
+            continue;
+        }
+        let (r, rh) = (sub(pa, com), sub(pb, x));
+        let denominator = 1.0 / mass
+            + dot(n, cross(mul(&inverse_inertia, cross(r, n)), r))
+            + host_inverse_mass
+            + dot(n, cross(mul(&host_inverse_inertia, cross(rh, n)), rh));
+        if !(denominator > 0.0 && denominator.is_finite()) {
+            continue;
+        }
+        let j = scale(n, (1.0 + e) * closing / denominator);
+        let (dv, dw) = (scale(j, 1.0 / mass), mul(&inverse_inertia, cross(r, j)));
+        let kick = |b: &mut BodySnapshot| {
+            let lever = sub(v(b.rates.position), com);
+            b.rates.linear_velocity = out(add(add(v(b.rates.linear_velocity), dv), cross(dw, lever)));
+            b.rates.angular_velocity = out(add(v(b.rates.angular_velocity), dw));
+        };
+        for b in rider.iter_mut().filter(|b| physical(b)) {
+            kick(b);
+        }
+        // The skeleton's animation drive targets ride in the same frame.
+        for b in carried.iter_mut() {
+            kick(b);
+        }
+        let reports = struck
+            .into_iter()
+            .map(|(position, mut report)| {
+                let shift = add(dv, cross(dw, sub(position, com)));
+                for k in 0..3 {
+                    report.body_b.linear_velocity[k] += shift[k] as f32;
+                }
+                report
+            })
+            .collect();
+        velocity = add(velocity, dv);
+        spin = add(spin, dw);
+        let host_body = &mut proxies[proxy];
+        host_body.rates.linear_velocity = out(sub(v(host_body.rates.linear_velocity), scale(j, host_inverse_mass)));
+        host_body.rates.angular_velocity =
+            out(sub(v(host_body.rates.angular_velocity), mul(&host_inverse_inertia, cross(rh, j))));
+        impacts.push(HostImpact {
+            proxy,
+            point: [pb[0] as f32, pb[1] as f32, pb[2] as f32],
+            impulse_on_host: [-j[0] as f32, -j[1] as f32, -j[2] as f32],
+            closing: closing as f32,
+            restitution: e as f32,
+            assembly_mass: mass as f32,
+            reports,
+        });
+    }
+    impacts
+}

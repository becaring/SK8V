diff --git b/crates/skate-host/src/physics/bridge/difficulty.rs b/crates/skate-host/src/physics/bridge/difficulty.rs
new file mode 100644
index 0000000..1c7fd62
--- /dev/null
+++ b/crates/skate-host/src/physics/bridge/difficulty.rs
@@ -0,0 +1,17 @@
+//! SkateV difficulty (overlay patch 0043): selects one of retail's physics_mode
+//! collections (easy, normal, hardcore, motorized) on a live session. Every
+//! per-mode table is loaded for all modes and picked by this index each frame.
+use super::Session;
+use crate::difficulty::Difficulty;
+
+impl Session {
+    /// 0 easy, 1 normal, 2 hardcore, 3 motorized. False (unchanged) otherwise.
+    pub fn set_difficulty(&mut self, index: u32) -> bool {
+        let Some(d) = Difficulty::ALL.get(index as usize) else { return false };
+        self.physics.set_difficulty(*d);
+        true
+    }
+    pub fn difficulty(&self) -> u32 {
+        self.physics.difficulty_index()
+    }
+}

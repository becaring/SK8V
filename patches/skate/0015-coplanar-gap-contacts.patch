+/// SkateV near-coplanar gap rule (owner direction 2026-10-02): a seam, crack
+/// or narrow gap across which the riding surface continues in the same plane
+/// must neither snag nor kick the board; a real curb, ledge or wall must stay
+/// an obstacle. Board scale comes from retail data: the gap must be narrower
+/// than the wheelbase (truck centres, `authored_body_transforms`) and no
+/// deeper than the board's ground clearance under the deck (wheel radius
+/// below the truck, `drive_frames`). A contact pushing the board back
+/// horizontally against the far side of such a gap is dropped; the
+/// continuing surface's own contacts then lift the wheel along that
+/// surface's normal, so the dip and rise remain.
+fn coplanar_gap_contact(
+    source: &WorldTriangle,
+    contact: Vector3,
+    contact_normal: Vector3,
+    candidates: &[usize],
+    triangles: &[WorldTriangle],
+    bounds: &[Bounds],
+) -> bool {
+    let wheelbase = RETAIL_DECK_MID_LENGTH
+        + RETAIL_TRUCK_Z_POSITION_FRONT
+        + RETAIL_TRUCK_Z_POSITION_BACK;
+    let clearance = RETAIL_WHEEL_RADIUS - RETAIL_TRUCK_Y_POSITION;
+    // Only a lateral push is an artifact; vertical response always stays.
+    let lateral = contact_normal.x.hypot(contact_normal.z);
+    if lateral < 0.5 {
+        return false;
+    }
+    let (dx, dz) = (contact_normal.x / lateral, contact_normal.z / lateral);
+    let face = source.triangle.feature.normal;
+    // The far side: the walkable surface just beyond the contact (away from
+    // the board), at or above it and within the clearance.
+    let beyond = (contact.x - dx * 0.03, contact.z - dz * 0.03);
+    let top = source.triangle.vertices.iter().map(|v| v.y).fold(contact.y, f32::max);
+    let far = walkable_surfaces(beyond.0, beyond.1, candidates, triangles, bounds)
+        .filter(|(h, _, _)| *h >= contact.y - 0.01 && *h <= top + 0.02 && *h <= contact.y + clearance)
+        .max_by(|a, b| a.0.total_cmp(&b.0));
+    let Some((far_h, far_n, _)) = far else { return false };
+    if face.y >= IMPORTED_SEAM_MIN_UP && face.x * far_n.x + face.y * far_n.y + face.z * far_n.z < 0.9986 {
+        return false;
+    }
+    let far_point = Vector3::new(beyond.0, far_h, beyond.1);
+    let plane_at = |x: f32, z: f32| far_point.y - (far_n.x * (x - far_point.x) + far_n.z * (z - far_point.z)) / far_n.y;
+    // The near side: the same plane must carry on within a wheelbase, and
+    // the gap between must be no deeper than the clearance.
+    let mut deepest = (plane_at(contact.x, contact.z) - contact.y).max(0.0);
+    let steps = (wheelbase / 0.025).ceil() as usize;
+    for k in 0..=steps {
+        let s = k as f32 * 0.025;
+        let (x, z) = (contact.x + dx * s, contact.z + dz * s);
+        let plane = plane_at(x, z);
+        let mut level = false;
+        for (h, n, _) in walkable_surfaces(x, z, candidates, triangles, bounds) {
+            if h > plane + 0.01 {
+                continue;
+            }
+            if (h - plane).abs() <= 0.01 && n.x * far_n.x + n.y * far_n.y + n.z * far_n.z >= 0.9986 {
+                level = true;
+            } else if plane - h <= clearance + 0.25 {
+                deepest = deepest.max(plane - h);
+            }
+        }
+        if level && s > 0.0 {
+            return deepest <= clearance;
+        }
+    }
+    false
+}
+
+/// SkateV stacked-sheet rule (owner direction 2026-10-02: "make the plank
+/// lips passable"). GTA builds piles of plywood sheets (Del Perro parking
+/// roof kicker, visual and collision identical) as overlapping boxes whose
+/// edges stand proud of the sheet below. A lateral contact is dropped at
+/// the edge of an upper sheet lying on the surface the board rides (that
+/// surface continues underneath the upper sheet, within 1.5 cm and 5
+/// degrees), and at a lower sheet's edge tucked under the sheet the board
+/// rides (a walkable sheet overhangs it on the board's side). Steps are
+/// limited to the board's clearance. A curb or a deck riser has neither a
+/// riding surface underneath its top nor a sheet over its face, so it stays
+/// an obstacle.
+fn stacked_sheet_lip(
+    contact: Vector3,
+    contact_normal: Vector3,
+    candidates: &[usize],
+    triangles: &[WorldTriangle],
+    bounds: &[Bounds],
+) -> bool {
+    let clearance = RETAIL_WHEEL_RADIUS - RETAIL_TRUCK_Y_POSITION;
+    let lateral = contact_normal.x.hypot(contact_normal.z);
+    if lateral < 0.5 {
+        return false;
+    }
+    let (dx, dz) = (contact_normal.x / lateral, contact_normal.z / lateral);
+    let front = (contact.x + dx * 0.03, contact.z + dz * 0.03);
+    // A lower sheet's edge under the sheet the board rides: a walkable sheet
+    // passes over the contact on the board's side, within the clearance.
+    if walkable_surfaces(front.0, front.1, candidates, triangles, bounds)
+        .any(|(h, _, _)| h > contact.y + 0.005 && h <= contact.y + clearance)
+    {
+        return true;
+    }
+    // The surface the board rides, just in front of the edge, at or below it.
+    let Some((near_h, near_n, _)) = walkable_surfaces(front.0, front.1, candidates, triangles, bounds)
+        .filter(|(h, _, _)| *h <= contact.y + 0.01 && *h >= contact.y - clearance)
+        .max_by(|a, b| a.0.total_cmp(&b.0))
+    else {
+        return false;
+    };
+    let near_at = |x: f32, z: f32| near_h - (near_n.x * (x - front.0) + near_n.z * (z - front.1)) / near_n.y;
+    // The upper sheet just beyond the edge, above the riding surface.
+    let beyond = (contact.x - dx * 0.03, contact.z - dz * 0.03);
+    let under = near_at(beyond.0, beyond.1);
+    let surfaces: Vec<_> = walkable_surfaces(beyond.0, beyond.1, candidates, triangles, bounds).collect();
+    let Some(&(_top, _, _)) = surfaces
+        .iter()
+        .filter(|(h, _, _)| *h > under + 0.015 && *h <= under + clearance && *h >= contact.y - 0.01)
+        .min_by(|a, b| a.0.total_cmp(&b.0))
+    else {
+        return false;
+    };
+    // The riding surface carries on underneath the upper sheet.
+    surfaces.iter().any(|(h, n, _)| {
+        (h - under).abs() <= 0.015 && n.x * near_n.x + n.y * near_n.y + n.z * near_n.z >= 0.9962
+    })
+}
+
+/// Walkable faces over (x, z): height there, normal, index.
+fn walkable_surfaces<'a>(
+    x: f32,
+    z: f32,
+    candidates: &'a [usize],
+    triangles: &'a [WorldTriangle],
+    bounds: &'a [Bounds],
+) -> impl Iterator<Item = (f32, Vector3, usize)> + 'a {
+    candidates.iter().filter_map(move |&i| {
+        let other = &triangles[i];
+        let n = other.triangle.feature.normal;
+        if n.y < IMPORTED_SEAM_MIN_UP {
+            return None;
+        }
+        let b = bounds[i];
+        if x < b.min.x - 0.001 || x > b.max.x + 0.001 || z < b.min.z - 0.001 || z > b.max.z + 0.001 {
+            return None;
+        }
+        let p = other.triangle.vertices;
+        let h = p[0].y - (n.x * (x - p[0].x) + n.z * (z - p[0].z)) / n.y;
+        point_in_floor_triangle(Vector3::new(x, h, z), p).then_some((h, n, i))
+    })
+}

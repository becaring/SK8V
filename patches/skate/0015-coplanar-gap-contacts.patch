+    let mut pile: Vec<WorldTriangle> = Vec::new();
+    pile.extend(floor(-1., 2., 0.));
+    pile.extend(floor(0., 1., 0.047));
+    pile.extend(riser_at(0., 0., 0.047));
+    assert!(sheet_lip(&pile, [0., 0.02, 0.], [-1., 0., 0.]), "front edge of a sheet on the floor");
+    // A lower sheet's edge tucked under an upper sheet the board rides: the
+    // upper sheet (at 0.094) overhangs the contact on the board's side.
+    let mut tucked = pile.clone();
+    tucked.extend(floor(-0.5, 0.3, 0.094));
+    assert!(sheet_lip(&tucked, [0., 0.047, 0.], [-1., 0., 0.]), "lip under an upper sheet");
+    // A real 7.5 cm curb: the road ends at the curb face.
+    let mut curb: Vec<WorldTriangle> = Vec::new();
+    curb.extend(floor(-1., 0., 0.));
+    curb.extend(floor(0., 1., 0.075));
+    curb.extend(riser_at(0., 0., 0.075));
+    assert!(!sheet_lip(&curb, [0., 0.04, 0.], [-1., 0., 0.]));
+    // A step taller than the board's clearance, even on a continuing floor.
+    let mut tall: Vec<WorldTriangle> = Vec::new();
+    tall.extend(floor(-1., 2., 0.));
+    tall.extend(floor(0., 1., 0.2));
+    tall.extend(riser_at(0., 0., 0.2));
+    assert!(!sheet_lip(&tall, [0., 0.1, 0.], [-1., 0., 0.]));
+}

+// SkateV stacked-sheet rule (plywood piles).
+fn sheet_lip(triangles: &[WorldTriangle], contact: [f32; 3], normal: [f32; 3]) -> bool {
+    let bounds: Vec<Bounds> = triangles.iter().map(|t| Bounds::from_points(t.triangle.vertices).unwrap()).collect();
+    let candidates: Vec<usize> = (0..triangles.len()).collect();
+    let n = Vector3::new(normal[0], normal[1], normal[2]);
+    let len = (n.x * n.x + n.y * n.y + n.z * n.z).sqrt();
+    stacked_sheet_lip(
+        Vector3::new(contact[0], contact[1], contact[2]),
+        Vector3::new(n.x / len, n.y / len, n.z / len),
+        &candidates,
+        triangles,
+        &bounds,
+    )
+}

+// SkateV near-coplanar gap rule. Skate space: Y up; the board travels +x.
+fn floor(x0: f32, x1: f32, y: f32) -> [WorldTriangle; 2] {
+    let p = |x: f32, z: f32| [x, y, z];
+    [tri([p(x0, -1.), p(x0, 1.), p(x1, 1.)]), tri([p(x0, -1.), p(x1, 1.), p(x1, -1.)])]
+}
+/// A riser at `x` from `y0` up to `y1`, facing -x (toward the board).
+fn riser_at(x: f32, y0: f32, y1: f32) -> [WorldTriangle; 2] {
+    [tri([[x, y0, -1.], [x, y1, 1.], [x, y0, 1.]]), tri([[x, y0, -1.], [x, y1, -1.], [x, y1, 1.]])]
+}
+/// Floor at 0 before x = 0 and after x = `width`, a `depth` deep gap
+/// between; returns the world and the far riser's first triangle.
+fn gap(width: f32, depth: f32) -> (Vec<WorldTriangle>, usize) {
+    let mut w: Vec<WorldTriangle> = Vec::new();
+    w.extend(floor(-1., 0., 0.));
+    w.extend(floor(0., width, -depth));
+    w.extend(floor(width, width + 1., 0.));
+    w.extend(riser_at(0., -depth, 0.));
+    let far = w.len();
+    w.extend(riser_at(width, -depth, 0.));
+    (w, far)
+}
+fn gap_contact(triangles: &[WorldTriangle], source: usize, contact: [f32; 3], normal: [f32; 3]) -> bool {
+    let bounds: Vec<Bounds> = triangles.iter().map(|t| Bounds::from_points(t.triangle.vertices).unwrap()).collect();
+    let candidates: Vec<usize> = (0..triangles.len()).collect();
+    let n = Vector3::new(normal[0], normal[1], normal[2]);
+    let len = (n.x * n.x + n.y * n.y + n.z * n.z).sqrt();
+    coplanar_gap_contact(
+        &triangles[source],
+        Vector3::new(contact[0], contact[1], contact[2]),
+        Vector3::new(n.x / len, n.y / len, n.z / len),
+        &candidates,
+        triangles,
+        &bounds,
+    )
+}
